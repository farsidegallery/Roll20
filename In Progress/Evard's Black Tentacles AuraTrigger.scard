!script {{
  +++5Elib;snlib;Farsidelib+++
  
  --#sourceToken|@{selected|token_id}
  --#reentrant|My Cool Script @{selected|character_id}
  --#whisper|self,gm
  
  --/|Script Name : Evard's Black Tentacles
  --/|Version     : 1.1.0
  --/|Requires SC : ScriptCards Library 5Elib/snlib/Farsidelib
  --/|Author	  : Farsidegallery
  --/|  
  --/|  Script prompts user for spell level used and makes sure the slot is available.  and spawn the designated token to the VTT. Script calculates
  --/|  It will deduct 1 spell slot from the appropriate level
  --/|
  
  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________
  
  --&SpellName|Evard's Black Tentacles
  --&MinimumSpellLevel|4

  --/|Enter name for Evard's Black Tentacles Character.
  --&TentacleName|[*S:character_name] Evard's Black Tentacles
  
  --&Evardlink|https://files.d20.io/images/467973190/edLerYdADmvNAlqYgQY6kw/med.webm?1765852892
  
  --/| Place the name and URL of your spell target token here.
  --&SpellTargetToken|Spell Token
  --&URLlink|https://files.d20.io/images/469753332/ew1SU1DcQK4eborJlOqNQw/original.png
  
  --/| ____________________ End Global User Variables ___________________________________________________________________________________________
  
  --/|Helper variable build up to allow us to include a target prompt in an rbutton
  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[ 
  --&cbrac|]
  --&oparen|(
  --&cparen|)
  
  -->far_LoadTokenMarkers|
  
  --#title|[&SpellName]
  
  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
  -->far_GetAvailableSpellLevels|[*S:character_id];[&MinimumSpellLevel];SpellCastLevel
  --?[@SpellCastLevel(length)] -eq 0|>far_FatalError;No Spell Slots Available;ERROR;No spell slots are available to cast [&SpellName]
  
  --#leftsub|[*R:spellcastingtime]
  --#rightsub|[*R:spellrange]
  --?[*R:spellconcentration] -inc 1|&duration;[*R:spellduration] [b](Concentration)[/b]|&duration;[*R:spellduration]
  -->far_PlayEffects|[*S:t-id];;burn-magic;;;
  
  -->ChooseFunction|
  --X|
  
  --:ChooseFunction|
   --+Choose Function: |[rbutton]New Cast::New[/rbutton][rbutton]Dismiss::Remove[/rbutton]
   --X|
  
  --:New|
   --#emotetext|[*S:character_name] casts [&SpellName]!
   -->GetCharID|"[&TentacleName]";SummonID
   --!a:[&SummonID]|!SaveDC:[*S:spell_save_dc]
   --!a:[*S:character_id]|!ConcentrationSpell:[&TentacleName]
   -->LibSN_ADD_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];10

   -->CAST_SPELL|
   
   --/|SPAWN Evard's Black Tentacles Token
   --:SpawnToken|
    --!ot:TentacleTID|name:"[&TentacleName]"|left:[*T:t-left]|top:[*T:t-top]|width:[=[*T:t-width]*5]|height:[=[*T:t-height]*5]|imgsrc:"[&Evardlink]"|bar1_value:1|represents:[&SummonID]|showname:false|tooltip:DC [*S:spell_save_dc]|show_tooltip:true||aura1_radius:"-0.01"|aura1_color:"#00000050"|aura1_square:"true"|gmnotes:${[{"color":"#00000050","name":"Evard's Black Tentacles","icon":"snail","toNPCs":true,"toPCs":true,"toGraphics":false,"applySelf":false,"removeOnExit":true,"targetVfxOnEnter":"shield-death","toLayers":"objects,gmlayer","ignoreWalls":false,"chatActionOnEnter":"!script {!{ +++5Elib;snlib;Farsidelib+++ --&hpBar|1 --&tempHPbar|4 --&attrib|dexterity --~shortattrib|string;left;3;[&attrib] --~Displayattrib|string;touppercase;[&shortattrib] --#sourcetoken|[ATID] --#targettoken|[TID] --#emoteTargetTokenSize|75 --#emoteText|Evard's Black Tentacles attacks [*T:character_name]! --&DamageDice|3d6 --#whisper| -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&RestrainedMarker];RestrainedFlag;RestrainedCount --?[&RestrainedFlag] -eq 1|>Restrained |>CheckSave --X| End Script --:Restrained| -->far_CheckDamageModifiers|[*T:character_id];[&damageType];damageMod;0;0;0 --=damage|[&DamageDice] [&damageMod] --+Damage: |[*T:character_name] is already restrained and continues to be pummeled. [*T:character_name] takes [$damage] damage. -->far_DamageTokenmod|[*T:t-id];1;4;-[$Damage];0;0;0 --?\"[&damageMod]\" -inc \"Immune\"|[ --+|[br] --+Immune! |[*T:character_name] is [b]IMMUNE[/b] to [&damageType] damage! --]| --=FinalHP|[*T:t-bar[&hpBar]_value]+[*T:t-bar[&tempHPbar]_value]-[$Damage] --?[$FinalHP] -le 0|>Died --<| --:CheckSave| --?\"[*T:npc]\" -ne \"1\"|PCRoll |NPCRoll --:PCRoll| --&control|[*O:[*T:t-represents]:character:controlledby] --&playername|[*O:[&control]:player:displayname] --?\"X[&playername]\" -eq \"X\"|[ --#whisper|gm --]|[ --#whisper|[&playername],gm --]| -->ChooseRoll|PC --:NPCRoll| --#whisper|gm -->ChooseRoll|NPC --:ChooseRoll| --&function|[%1%] --+|[c]Choose Saving Throw Type:[/c] --+|[c][rbutton]Advantage::[&function];2d20kh1[/rbutton][rbutton]Normal::[&function];1d20[/rbutton][rbutton]Disadvantage::[&function];2d20kl1[/rbutton][/c] --X| --:NPC| --&saveDice|[&reentryval] --?[*T:npc] -eq 1 -and [*T:npc_[&shortattrib]_save_flag] -gt 0|&Save;npc_[&shortattrib]_save |&Save;[&attrib]_mod --=Save|[&saveDice] + [*T:[&Save]] [&Displayattrib] --#whisper| --?[$Save.Base] -eq 20|>Crit --?[$Save] -ge [$DC]|>Pass |>Fail --:PC| --&saveDice|[&reentryval] -->far_Check_GLOBAL_MOD_EXISTS|[*T:character_id]; save; [&damageType]; damageSave -->far_Check_GLOBAL_ATTRIB_SAVE_EXISTS|[*T:character_id]; [&attrib]; attribSaveRoll --?[&damageSave] -eq 1 -or [&attribSaveRoll] -eq 1 -and \"[&saveDice]\" -eqi \"1d20\"|&saveDice;2d20kh1 --?[&damageSave] -eq 1 -or [&attribSaveRoll] -eq 1 -and \"[&saveDice]\" -eqi \"2d20kl1\"|&saveDice;1d20 -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&InspirationMarker];InspiredFlag;InspiredCount -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BardicMarker];BardicFlag;BardicCount -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BaneMarker];BaneMarkerFlag;BaneMarkerCount -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&HexMarker];HexMarkerFlag;HexMarkerCount -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&HexBladeMarker];HexBladeMarkerFlag;HexBladeMarkerCount --?[&InspiredFlag] -ne 0 |>far_Inspiration;[*T:t-id];[&InspirationMarker];[&saveDice];saveDice -->far_FIND_ACTIVE_GLOBAL_SAVE_MODS|[*T:character_id];GlobalSave -->far_FIND_ACTIVE_GLOBAL_SKILL_MODS|[*T:character_id];GlobalSkill --=InitSave|[&saveDice] --c[&saveDice]|2d20kh1:&DisplayDice;Advantage|1d20:&DisplayDice;1d20|2d20kl1:&DisplayDice;Disadvantage --+Rolling [&DisplayDice]: |[$InitSave] --+|[br] --?[$InitSave.Base] -eq 20|>Crit --=attribSaveRoll|[$InitSave] + [*T:[&attrib]_save_bonus] [&Displayattrib] --?[&BardicFlag] -eq 1|>far_Bardic;[*T:t-id];[&BardicMarker];[$Scriptcheck];[$InitSave.Base];[$attribSaveRoll];BardRoll --?[&BaneMarkerFlag] -eq 1|&Baneroll;+ - 1d4 [Bane] |&Baneroll; --=Save|[$InitSave] + [*T:[&attrib]_save_bonus] [&obrac][&Displayattrib][&cbrac] [&GlobalSave] [&GlobalSkill] [&Baneroll] [&BardRoll] --#whisper| --?[$Save] -ge [$DC]|>Pass |>Fail --:Crit| --+Save: |[*T:t-name] rolled a [$Save.Base] vs a DC [$DC] and cannot fail the saving throw. --+|[br] --+Result: |[*T:t-name] takes no damage. -->Output| --:Pass| --+Save: |[*T:t-name] rolled a [$Save] vs a DC [$DC] and passed the saving throw. --+|[br] --+Result: |[*T:t-name] takes no damage. -->far_DamageTokenmod|[*T:t-id];[&hpBar];[&tempHPbar];-[$Damage];0;0;0 -->Output| --:Fail| -->far_CheckDamageModifiers|[*T:character_id];[&damageType];damageMod;0;0;0 --=Damage|[&DamageDice][&damageMod] --+Save: |[*T:t-name] rolled a [$Save] vs a DC [$DC] and failed the saving throw. --+|[br] --+Result: |[*T:t-name] takes [$Damage] hp of [&damageType] damage and is restrained. -->LibSN_ADD_STATUS_MARKER|[*T:t-id];[&RestrainedMarker]; -->far_DamageTokenmod|[*T:t-id];[&hpBar];[&tempHPbar];-[$Damage];0;0;0 --?\"[&damageMod]\" -inc \"Immune\"|[ --+|[br] --+Immune! |[*T:character_name] is [b]IMMUNE[/b] to [&damageType] damage! --]| -->Output| --:Output| --=FinalHP|[*T:t-bar[&hpBar]_value]-[$Damage] --?[$FinalHP] -le 0|>Died --X| --:Died| --#whisper| --?[$HexBladeFlag] -eq 1 -and [&HexBladeMarkerFlag] -eq 1|>HexHeal --~|turnorder;removetoken;[*T:t-id] --?\"X[&HexMarkerFlag]\" -eq \"X1\" -and \"X[*S:ConcentrationSpellTargetToken]\" -eqi \"X[*T:t-id]\"|[ -->LibSN_REMOVE_STATUS_MARKER|[*T:t-id];[&HexMarker];0 -->LibSN_REMOVE_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];0 --]| --?\"X[&HexBladeMarkerFlag]\" -eq \"X1\" -and \"X[*S:CurseTarget]\" -eq \"X[*T:t-id]\"|[ -->LibSN_REMOVE_STATUS_MARKER|[*T:t-id];[&HexBladeMarker];0 --]| -->LibSN_ADD_STATUS_MARKER|[*T:t-id];[&DeathMarker] --<| --:HexHeal| -->far_HexHeal|[*S:character_id];[*S:t-id] --<| !}!}","chatActionOnEndTurn":"!script !{!{ +++5Elib;snlib;dnd5elib;LibSiG+++ --#targettoken|[TID] --#emoteTargetTokenSize|75 --?[*[*[TID]:t-represents]:Aura] -eq 1|>NoMore --&SaveType|str -->LibSiG_SetSave2|[&SaveType] --=Damage|[*[ATID]:t-bar1_value] --#hideTitleCard|1 -->Lib5E_CheckDamageModifiers|ResistType;bludgeoning --=DamageRoll|[$Damage][&ResistType] --=AdjDmg|[$DamageRoll] --+RTDRAD|[&ResistType] [$Damage] [$DamageRoll] [$AdjDmg] --?[*[TID]:npc] -ne 1|>PC --?[*[TID]:npc] -eq 1 -and [*[TID]:npc_[&SaveType]_save_flag] -gt 0|&Save;npc_[&SaveType]_save|&Save;[&Save2]_save_bonus --=TargetSave|1d20 + [*[TID]:[&Save]] --#targetToken|[*[TID]:t-id] --?[$TargetSave] -ge [*[ATID]:t-bar3_value] | [--#emoteText|With a Str save of [$TargetSave], [TNAME] nimbly dodges the grasping tentacles that seek to hold them --]|[-->LibSN_APPLY_DAMAGE_OR_HEALING|[TID];1;-[$AdjDmg];0;0;0 --#emoteText|With a Str save of [$TargetSave] vs DC [*[ATID]:t-bar3_value] , [TNAME] fails to escape the grasping tentacles and takes [$AdjDmg] bludgeoning damage from the tentacles that grab them --!t:[TID]|statusmarkers:restrained::6747879 --]| --X| --:PC| --#emoteText|[TNAME] must make a DC [*[ATID]:t-bar3_value] Str save or take [$AdjDmg] bludgeoning damage --:End| --!a:[TID]|!Aura:0 --X| --:NoMore| --#hideTitleCard|1 --#emoteText|[TNAME] will take no more damage from [ANAME] THIS turn --!a:[TID]|!Aura:0 --X| --X| !}!}","chatActionOnExit":"!script !{!{ +++5Elib;snlib+++ --#targettoken|[TID] --#emoteTargetTokenSize|75 --#emoteText|[TNAME] moves out of harm's way --#hideTitleCard|1 --!a:[TID]|!Aura:0 --!t:[TID]|statusmarkers:-[&RestrainedMarker]] !}!}"}]$}
	--z:graphic:[&TentacleTID]|toback

    --~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&SpellTargetToken]
    --~|object;token;delete;[@tokens(0)]
	
	-->Modtoken|
    --X|
   
  --/| ____________________ Procedures_______________________________________________________________________________________
  
  --:GetCharID|CharacterName;StringVariableForCharID
   --~|array;objects:character;SpiritCharArr;[%1%]
   --?[@SpiritCharArr(length)] -ne 1|>far_LogFatalError;Could not find character named [%1%]
   --&[%2%]|[@SpiritCharArr(0)]
   --<|
  
  --:CAST_SPELL|
   --+|Move Spell Token to desired location and then target it by casting the spell.
   --/| (1) Spawn the effect template and find the ID for it
   --!ot:NewTID|name:"[&SpellTargetToken]"|_pageid:[*S:t-_pageid]|left:[=[*S:t-left]+70]|top:[*S:t-top]|width:[*S:t-width]|height:[*S:t-height]|imgsrc:"[&URLlink]"|bar1_value:1|represents:"[&SpellTargetToken]"|showname:0|t-aura1_radius:10|t-aura1_color:#d0e0e3
   --z:graphic:[&NewTID]|tofront
   -->SetAbility|
   --+Target: |[rbutton]Target the Spell Token.::SetTarget;[&TB]target|token_id}[/rbutton]
   --X|
  
  --:SetTarget|
   --#targettoken|[&reentryval]
   --&TargetName|[*T:t-name]
   --?"[&TargetName]" -eq "[&SpellTargetToken]"|SpawnToken
   --<|
  
  --:SetAbility|
   --~|array;objects:ability;AbilityArr;;[&AOETargetID]
   --!ability:[@AbilityArr(0)]|istokenaction:False
   --!ability:[@AbilityArr(1)]|istokenaction:False
   --!ability:[@AbilityArr(2)]|istokenaction:False
   --!ability:[@AbilityArr(3)]|istokenaction:False
   --<|
  
  --:Modtoken|
   --?[*S:npc] -eq 1 |[ 
	--~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&TentacleName]
    --!graphic:[@tokens(0)]|gm_only_tooltip:1
	--]|
   -->Output|
   
  --:Output|
   --#whisper|
   --+|[*S:character_name] summons [&SpellName]!
   --+|[br]
   --+Duration: |[&duration]
   --+Desc: |[*R:spelldescription]
   -->far_DeductSpellSlot|[*S:t-id];[&MinimumSpellLevel]
   --X|
  
  --:Remove|
   --~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&TentacleName]
   --~|object;token;delete;[@tokens(0)]
   --#whisper|
   --#emotetext|[&TentacleName] vanishes!
   --+|[*S:character_name] is no longer concentrating.
   -->LibSN_REMOVE_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker]
   --!a:[*S:character_id]|!ConcentrationSpell:**
   --X|
}}