!script {{
+++5Elib;snlib;ActionMenuAddons;dnd5elib;LibSiG+++
--#sourceToken|@{selected|token_id}
--#emoteBackground|#223030
--#emoteFontColor|#ff9900
--#titleCardBackground|#ff9900
--#evenRowBackground|#bbf970
--#oddRowBackground|#f9dc9e
--#subtitleFontColor|#363E40
--/|variables for summoned AoE token
--=CastLevel|?{What Level Cast?|2|3|4|5|6|7|8|9}
--=dice|2*[$CastLevel.Raw]
--&damage|[$dice.Raw]d4
--#title|Cloud of Daggers
--&SpellName|Cloud of Daggers
--/| Insert link to token image below
--&URLlink|https://files.d20.io/images/486117486/L8MVBbJgiQNhV0UzJY3o1g/original.png

--#emoteText|[*S:character_name] casts Cloud of Daggers!

-->LibSiG_GetAndCheckSlotInformation|[*S:t-id];[$CastLevel]
-->Lib5E_EXPEND_SPELL_SLOT|[*S:character_id];[$CastLevel]
-->LibSN_ADD_STATUS_MARKER|[*S:t-id];blue

-->GetSpellTokenID|[&SpellName];STokenID
--!ot:NewTID|name:"[&SpellName]"|_pageid:[*S:t-_pageid]|left:[=[*S:t-left]+140]|top:[*S:t-top]|width:[=[*S:t-width]*1]|height:[=[*S:t-height]*1]|imgsrc:"[&URLlink]"|represents:"[&STokenID]"|showname:1|bar1_value:"[&damage]"|aura2_radius:"-0.01"|aura2_color:"#B50E1E50"|gmnotes:${[{"color":"#B50E1E50","name":"Cloud of Daggers","toNPCs":true,"toPCs":true,"toGraphics":false,"applySelf":false,"removeOnExit":true,"targetVfxOnEnter":"shield-fire","toLayers":"objects,gmlayer","ignoreWalls":false,"chatActionOnEnter":"!script !{!{ +++5Elib;snlib;dnd5elib;LibSiG+++ --#targettoken|[TID]--#emoteTargetTokenSize|75 --=Damage|[*[ATID]:t-bar1_value] --#hideTitleCard|1 -->Lib5E_CheckDamageModifiers|ResistType;slashing  --=DamageRoll|[$Damage][&ResistType] --=AdjDmg|[$DamageRoll]  -->LibSN_APPLY_DAMAGE_OR_HEALING|[TID];1;-[$AdjDmg];0;0;0 --#emoteText|[TNAME] enters an area filled with slashing daggers and takes [$AdjDmg] slashing damage --!a:[TID]|!Aura:1 --X| !}!} ",
"chatActionOnEndTurn": "!script !{!{  +++5Elib;snlib;dnd5elib;LibSiG+++ --#targettoken|[TID]  --#emoteTargetTokenSize|75 --&CharID|[*T:character_id] --#hideTitleCard|1 --?[*[&CharID]:Aura] -eq 1|>NoMore --=Damage|[*[ATID]:t-bar1_value]  -->Lib5E_CheckDamageModifiers|ResistType;slashing  --=DamageRoll|[$Damage][&ResistType] --=AdjDmg|[$DamageRoll]  -->LibSN_APPLY_DAMAGE_OR_HEALING|[TID];1;-[$AdjDmg];0;0;0 --#emoteText|[TNAME] is hacked mercilessly by whirling glass blades for [$AdjDmg] slashing damage   --:End| --!a:[TID]|!Aura:0 --X|  --:NoMore| --#emoteText|[TNAME] will take no more damage from [ANAME] THIS turn --!a:[TID]|!Aura:0 --X| !}!}",
"chatActionOnExit": "!script !{!{ +++5Elib;snlib+++ --#targettoken|[TID] --#emoteTargetTokenSize|75 --&CharID|[*T:character_id] --#emoteText|[TNAME] moves out of harm's way  --#hideTitleCard|1 --!a:[TID]|!Aura:0 !}!}" }]$}
--z:graphic:[&NewTID]|toBack
--/|:LibSiG_CHECK_WILD_MAGIC|classdisplay;desiredclass;
-->LibSiG_CHECK_WILD_MAGIC|[*S:class_display];Wild Magic;
--X|Stop

--:GetSpellTokenID|CharacterName;StringVariableForCharID
   --~|array;objects:character;SpellCharArr;[%1%]
   --?[@SpellCharArr(length)] -ne 1|>LogFatalError;Could not find character named [%1%]
   --&[%2%]|[@SpellCharArr(0)]
   --<|
 --X|
 
  }}