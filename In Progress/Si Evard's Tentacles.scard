--#emoteText|[*S:character_name] casts Evard's Black Tentacles!

-->LibSiG_GetAndCheckSlotInformation|[*S:t-id];[$CastLevel]
--/|>Lib5E_EXPEND_SPELL_SLOT|[*S:character_id];[$CastLevel]

-->GetSpellTokenID|[&SpellName];STokenID
--!ot:NewTID|name:"[&SpellName]"|_pageid:[*S:t-_pageid]|left:[=[*S:t-left]+70]|top:[*S:t-top]|width:[=[*S:t-width]*4]|height:[=[*S:t-height]*4]|imgsrc:"[&URLlink]"|represents:"[&STokenID]"|showname:1|bar1_value:"[&damage]"|bar3_value:"[*S:spell_save_dc]"|aura2_radius:"-0.01"|aura2_color:"#00000050"|aura2_square:"true"|gmnotes:${[{"color": "#00000050","name": "Evard's Black Tentacles","icon": "snail","toNPCs": true,"toPCs": true,"toGraphics": false,"applySelf":false,"removeOnExit": true,"targetVfxOnEnter": "shield-death","toLayers": "objects,gmlayer","ignoreWalls":false,"chatActionOnEnter": "!script  !{!{ +++5Elib;snlib;dnd5elib;LibSiG+++ --#targettoken|[TID] --#emoteTargetTokenSize|75 --!a:[TID]|!Aura:1 --&SaveType|str  -->LibSiG_SetSave2|[&SaveType] --=Damage|[*[ATID]:t-bar1_value] --+Dam|[$Damage]  --/|#hideTitleCard|1 -->Lib5E_CheckDamageModifiers|ResistType;bludgeoning  --=DamageRoll|[$Damage][&ResistType] --=AdjDmg|[$DamageRoll] --?[*[TID]:npc] -ne 1|>PC --?[*[TID]:npc] -eq 1 -and [*[TID]:npc_[&SaveType]_save_flag] -gt 0|&Save;npc_[&SaveType]_save|&Save;[&Save2]_save_bonus --=TargetSave|1d20 + [*[TID]:[&Save]] --#targetToken|[*[TID]:t-id] --?[$TargetSave] -ge [*[ATID]:t-bar3_value] | [--#emoteText|With a Str save of [$TargetSave], [TNAME] nimbly dodges the grasping tentacles that seek to envelop them --]|[-->LibSN_APPLY_DAMAGE_OR_HEALING|[TID];1;-[$AdjDmg];0;0;0 --#emoteText|With a Str save of [$TargetSave] vs DC [*[ATID]:t-bar3_value] , [TNAME] fails to escape the grasping tentacles and takes [$AdjDmg] bludgeoning damage from the tentacles that grab them --!t:[TID]|statusmarkers:restrained::6747879 --]| --X| --:PC| --#emoteText|[TNAME] must make a DC [*[ATID]:t-bar3_value] Str save or take [$AdjDmg] bludgeoning damage --X| !}!} ",
"chatActionOnEndTurn": "!script !{!{ +++5Elib;snlib;dnd5elib;LibSiG+++ --#targettoken|[TID] --#emoteTargetTokenSize|75 --?[*[*[TID]:t-represents]:Aura] -eq 1|>NoMore --&SaveType|str  -->LibSiG_SetSave2|[&SaveType] --=Damage|[*[ATID]:t-bar1_value] --#hideTitleCard|1 -->Lib5E_CheckDamageModifiers|ResistType;bludgeoning  --=DamageRoll|[$Damage][&ResistType] --=AdjDmg|[$DamageRoll] --+RTDRAD|[&ResistType] [$Damage] [$DamageRoll] [$AdjDmg] --?[*[TID]:npc] -ne 1|>PC --?[*[TID]:npc] -eq 1 -and [*[TID]:npc_[&SaveType]_save_flag] -gt 0|&Save;npc_[&SaveType]_save|&Save;[&Save2]_save_bonus --=TargetSave|1d20 + [*[TID]:[&Save]] --#targetToken|[*[TID]:t-id] --?[$TargetSave] -ge [*[ATID]:t-bar3_value] | [--#emoteText|With a Str save of [$TargetSave], [TNAME] nimbly dodges the grasping tentacles that seek to hold them --]|[-->LibSN_APPLY_DAMAGE_OR_HEALING|[TID];1;-[$AdjDmg];0;0;0 --#emoteText|With a Str save of [$TargetSave] vs DC [*[ATID]:t-bar3_value] , [TNAME] fails to escape the grasping tentacles and takes [$AdjDmg] bludgeoning damage from the tentacles that grab them --!t:[TID]|statusmarkers:restrained::6747879 --]| --X| --:PC| --#emoteText|[TNAME] must make a DC [*[ATID]:t-bar3_value] Str save or take [$AdjDmg] bludgeoning damage --:End| --!a:[TID]|!Aura:0 --X|  --:NoMore| --#hideTitleCard|1 --#emoteText|[TNAME] will take no more damage from [ANAME] THIS turn --!a:[TID]|!Aura:0 --X| --X| !}!}",
"chatActionOnExit": "!script !{!{ +++5Elib;snlib+++ --#targettoken|[TID] --#emoteTargetTokenSize|75 --#emoteText|[TNAME] moves out of harm's way  --#hideTitleCard|1 --!a:[TID]|!Aura:0 --!t:[TID]|statusmarkers:-restrained::6747879 !}!}" }]$}
--z:graphic:[&NewTID]|toBack
--/|:LibSiG_CHECK_WILD_MAGIC|classdisplay;desiredclass;
-->LibSiG_CHECK_WILD_MAGIC|[*S:class_display];Wild Magic;
--X|Stop

