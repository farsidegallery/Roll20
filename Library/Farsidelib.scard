  --&BrokenMarker|Broken::7409891
  --&CharmedMarker|Charmed::7409947
  --&ConcentrationMarker|Concentrating::7409928
  --&DeafenedMarker|Deafened::7409946
  --&DeathMarker|dead
  --&DisadvantageMarker|Disadvantage::7409922
  --&DiseaseMarker|Nauseated::7409894
  --&FaerieFireMarker|pink
  --&FearMarker|Frightened::7409945
  --&HexMarker|Hexed::7409913
  --&HexBladeMarker|Hexed2::7409912
  --&HoldMarker|Paralyzed::7409941
  --&HunterMarker|Marked::7409918
  --&IncapacitatedMarker|Incapacitated::7409943
  --&InspirationMarker|Inspiration::7409921
  --&InvisibilityMarker|Invisible::7409942
  --&PoisonMarker|Poisoned::7409939  
  --&ProneMarker|Prone::7409938
  --&RageMarker|Raging::7409927
  --&RestrainedMarker|Restrained::7409937
  --&SleepMarker|Unconscious::7409935
  --&SlowMarker|Slow::7409900
  --&StunMarker|Stunned::7409936  
