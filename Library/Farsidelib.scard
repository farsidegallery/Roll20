 --:far_EmpowerSelect|DamageRollVariable;ReturnFunctionNameString;DamageChangeVar;DamageVar;ReturnCountFlag;IncomingCount;ExportCount
  --#whisper|self,gm
  --~|array;define;changedIndex;
  --~|array;fromrollvar;rolledDice;[%1%];rolled
  --&RollText|[$[%1%].RollText]
  --&function|[%2%]
  --?"X[%6%]" -ne "X"|=ChangeCount;[%6%]
  --?[$PointsAmmo] -le [$SorceryPoints] -or "X[$ChangeCount]" -eq "X[$EmpowerDice]"|[
   --=SkipFlag|1
   --^far_EmpowerNo|
   --]|
  --?"[&RollText]" -inc "Immune"|far_EmpowerNo
  --~DamageString|array;stringify;rolledDice;!@!
  --~|array;fromstring;DamageDiceRolls;!@!;[&DamageString]
  --&DieInformMsg|
  --+|You [&function] [*T:t-name] and rolled the following for Damage Dice:
  --+|[br]
  --%DiceMsg|foreach;DamageDiceRolls
   --&DieInformMsg|+  [&DiceMsg]
   --%|
  --+|[c][&DieInformMsg][/c]
  --+|[br]
  --+|[c]Do you want to spend a Sorcery Point to change a roll?[/c]
  --+|[c][rbutton]Yes::far_EmpowerYes[/rbutton]  [rbutton]No::far_EmpowerNo[/rbutton][/c]
  --X|
  --:far_EmpowerExit|
  --<|
   
 --:far_EmpowerYes|
  --&DieRollMsg|
  --=DisplayCount|
  --?"X[$ChangeCount]" -eq "X[$EmpowerDice]"|[
   --&FinalDieMsg|
   --+|You [&function] [*T:t-name] and rolled the following for Damage Dice:
   --+|[br]
   --%DiceMsg|foreach;DamageDiceRolls
   --&FinalDieMsg|+  [&DiceMsg]
   --%|
   --+|[c][&FinalDieMsg][/c]
   --+|[br]
   --+|You cannot change any more rolls.
   --+|[c][rbutton]Continue::far_EmpowerNo[/rbutton][/c]
   --X|
   --<|
   --]|
  --=DisplayCount|[$EmpowerDice]-[$ChangeCount]
  --=DieIndex|0
  --+|You can reroll a damage dice [$DisplayCount] more times (one time per dice only).
  --+|[br]
  --+|[c]Choose a Damage Dice to reroll:[/c]
  --%DieRoll|foreach;DamageDiceRolls
   --&DieRollMsg|+ [rbutton][&DieRoll]::far_DieSelect;[$DieIndex]%[&DieRoll][/rbutton]
   --=DieIndex|[$DieIndex]+1
   --%|
  --+|[c][&DieRollMsg][/c]
  --+|[br]
  --+|[c]When you are done rerolling click here: [/c]
  --+|[c][rbutton]Continue::far_EmpowerNo[/rbutton][/c]
  --X|
  --<|
   
 --:far_EmpowerNo|
  --?"X[$SkipFlag]" -eq "X1"|[
   --?"X[%5%]" -eq "X1" -and [$ChangeCount] -gt 0|=[%7%];[$ChangeCount] |=[%7%];[$EmpowerDice]
   --^far_EmpowerExit|
   --]|
  --?"X[$ChangeCount]" -gt "X0" -and "X[$ChangeFlag]" -ne "X1"|[
   --=SorceryPoints|[$SorceryPoints]+1
   --=ChangeFlag|[$ChangeFlag]+1
   --]|  
  --?"X[$ChangeCount]" -gt "X0"|[
   --=ChangedDamage|
   --%damage|foreach;DamageDiceRolls
    --=ChangedDamage|[$ChangedDamage]+[&damage]
    --%|
   --=[%4%]|[$ChangedDamage]
   --]|
  --?"X[%5%]" -eq "X1" -and [$ChangeCount] -gt 0|=[%7%];[$ChangeCount] |=[%7%];[$EmpowerDice]
  --<|
  
 --:far_DieSelect|
  --=IndexValue|[&reentryval(split,%,0)]
  --&DieValue|[&reentryval(split,%,1)]
  --=[%3%]|1
  --~Index|array;indexof;DamageDiceRolls;[$IndexValue]
  --~testvar|array;indexof;changedIndex;[$IndexValue]
  --?"[&testvar]" -eq "ArrayError" |[
   --~|array;add;changedIndex;[$IndexValue]
   --=ChangeCount|[$ChangeCount] + 1
   -->far_FindDieSize|
   --=NewDamage|1d[&DieSize]
   --+New Damage Roll: |[$NewDamage]
   --+|[br]
  --~|array;setatindex;DamageDiceRolls;[$IndexValue];[$NewDamage]
   --^far_EmpowerYes|
   --]|[
   --+Value [&DieValue]: |You have already changed this dice roll and cannot do so again!
   --+|[br]
   --]|
  --^far_EmpowerYes|
  --<|
  
 --:far_FindDieSize|   
  --~DieSize|string;after;d;[&RollText]
  
  --?"[&RollText]" -inc "+"|[
   --~DieSize|string;before;+;[&RollText]
   --~DieSize|string;trim;[&DieSize]
   --~DieSize|string;after;d;[&DieSize]
   --]|
   
  --?"[&RollText]" -inc "-"|[
   --~DieSize|string;before;-;[&RollText]
   --~DieSize|string;trim;[&DieSize]
   --~DieSize|string;after;d;[&DieSize]
   --]|
  
  --?"[&RollText]" -inc "Resistant"|[
   --~DieSize|string;before;\;[&RollText]
   --~DieSize|string;trim;[&DieSize]
   --~DieSize|string;after;d;[&DieSize]
   --]|

  --?"[&RollText]" -inc "Vulnerable"|[
   --~DieSize|string;before;*;[&RollText]
   --~DieSize|string;trim;[&DieSize]
   --~DieSize|string;after;d;[&DieSize]
   --]|
    
  --?"[&RollText]" -inc "[Crit]"|[
   --~DieSize|string;before;[&obrac];[&RollText]
   --~DieSize|string;trim;[&DieSize]
   --~DieSize|string;after;d;[&DieSize]
   --]|
   --<|