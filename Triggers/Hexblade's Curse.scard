!script {{
  --/|Script Name : Hexblade's Curse Trigger
  --/|Version     : 1.2.4
  --/|Requires SC : ScriptCards 3.0.25+, 5Elib/snlib/Farsidelib 1.5.2+ handouts in Notes and Description
  --/|
  --/|Trigger setup (ScriptCards_Triggers character):
  --/|  Ability name must be exactly: change:graphic
  --/|  listen_to_tokenmod is usually 1 on this character so Concentration can run. Hexblade does not read gmnotes.
  --/|  If a token gmnote contains ScriptCards syntax, trigger parsing can break; keep gmnotes plain on cursed tokens.
  --/|
  --/|Ends Hexblade's Curse when the marker expires (Combat Master ticks badge 9 to 0), the cursed target dies,
  --/|or the warlock dies or is incapacitated. Death heal (far_HexHeal) is trigger-only; spell scripts no longer call it.
  
  --#hidecard|1

  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________

  --/|What token marker is used for Hexblade's Curse? Must match HexBladeMarker in Farsidelib and PC Abilities/Hexblade's Curse.scard.
  --&HexBladeMarker|Hexed2::7409912

  --/|What token marker is used for Incapacitated? Must match IncapacitatedMarker in Farsidelib.
  --&IncapacitatedMarker|Incapacitated::7409943

  --/|Name of the hex graphic token placed on the warlock. Must match CharName in PC Abilities/Hexblade's Curse.scard and HexCharName in Farsidelib.
  --&HexCharName|Hex

  --/| ____________________ End Global User Variables ___________________________________________________________________________________________

  --/|TRIGGER_REPLACEMENTS
  +++5Elib;snlib;Farsidelib+++
  
  --/|Route cursed target by hex marker; route warlock by CurseTarget. Avoid reading CurseCaster on the warlock sheet.
  -->HexGetTokenCharAttr|[&GraphicOld_id];CurseTarget;;WarlockCurseTargetCheck
  --?"X[&GraphicOldstatusmarkers]" -ninc "[&HexBladeMarker]" -and "X[&WarlockCurseTargetCheck]" -eq "X"|SKIP
  --?"X[&GraphicOldstatusmarkers]" -inc "[&HexBladeMarker]"|>TargetCurseCheck
  --?"X[&WarlockCurseTargetCheck]" -ne "X"|>WarlockCurseCheck
  --X|
  
  --:TargetCurseCheck|
   -->HexGetTokenCharAttr|[&GraphicOld_id];CurseCaster;;TargetCurseCaster
   --?"X[&TargetCurseCaster]" -eq "X"|SKIP
   --?"X[&GraphicOldstatusmarkers]" -inc "dead"|>CheckMarkerExpiry
   --?"X[&GraphicOldbar1_value]" -ne "X"|[
    --?[&GraphicOldbar1_value] -gt 0|[
     --?"X[&GraphicNewbar1_value]" -eq "X"|[
      -->CallHexHeal|
      --^SKIP|
     --]|
     --?"X[&GraphicNewbar1_value]" -ne "X" -and [&GraphicNewbar1_value] -gt [&GraphicOldbar1_value]|>CheckMarkerExpiry
     --?"X[&GraphicNewbar1_value]" -ne "X" -and [&GraphicNewbar1_value] -le 0|[
      -->CallHexHeal|
      --^SKIP|
     --]|
    --]|
   --]|
   --?"X[&GraphicOldstatusmarkers]" -ninc "dead" -and "X[&GraphicNewstatusmarkers]" -inc "dead"|[
    -->CallHexHeal|
    --^SKIP|
   --]|
   --:CheckMarkerExpiry|
   --?"X[&GraphicOldstatusmarkers]" -inc "[&HexBladeMarker]" -and "X[&GraphicNewstatusmarkers]" -ninc "[&HexBladeMarker]"|[
    -->AnnounceCurseEnd|[&GraphicOld_id]
    -->far_EndHexbladeCurse|[&GraphicOld_id];[&TargetCurseCaster]
   --]|
   --^SKIP|
  
  --:CallHexHeal|
   --&WarlockToken|[&TargetCurseCaster]
   --#hidecard|0
   --#whisper|
   --#title|Hexblade Curse
   --#emoteText|[*[&GraphicOld_id]:t-name] is slain!
   -->far_HexHeal|[&GraphicOld_id]
   --<|
  
  --:WarlockCurseCheck|
   --?"X[&WarlockCurseTargetCheck]" -eq "X"|SKIP
   --&CurseTargetToken|[&WarlockCurseTargetCheck]
   --?"X[&CurseTargetToken]" -eq "X"|SKIP
   --?"X[*[&CurseTargetToken]:t-id]" -eq "X"|SKIP
   --?"X[&GraphicOldstatusmarkers]" -inc "dead"|>WarlockRecoverSkip
   --?"X[&GraphicOldbar1_value]" -ne "X"|[
    --?[&GraphicOldbar1_value] -gt 0|[
     --?"X[&GraphicNewbar1_value]" -eq "X"|[
      -->EndWarlockCurse|
      --^SKIP|
     --]|
     --?"X[&GraphicNewbar1_value]" -ne "X" -and [&GraphicNewbar1_value] -gt [&GraphicOldbar1_value]|>WarlockRecoverSkip
     --?"X[&GraphicNewbar1_value]" -ne "X" -and [&GraphicNewbar1_value] -le 0|[
      -->EndWarlockCurse|
      --^SKIP|
     --]|
    --]|
   --]|
   --?"X[&GraphicOldstatusmarkers]" -ninc "dead" -and "X[&GraphicNewstatusmarkers]" -inc "dead"|[
    -->EndWarlockCurse|
    --^SKIP|
   --]|
   --?"X[&GraphicOldstatusmarkers]" -ninc "Incapacitated" -and "X[&GraphicNewstatusmarkers]" -inc "Incapacitated"|[
    -->EndWarlockCurse|
    --^SKIP|
   --]|
   -->LibSN_CHECK_STATUS_MARKER|[&GraphicOld_id];[&IncapacitatedMarker];IncapFlag;IncapCount
   --?[&IncapFlag] -eq 1|[
    --?"X[&GraphicOldstatusmarkers]" -ninc "Incapacitated"|>EndWarlockCurse
   --]|
   --:WarlockRecoverSkip|
   --^SKIP|
  
  --:EndWarlockCurse|
   -->AnnounceCurseEnd|[&CurseTargetToken]
   -->far_EndHexbladeCurse|[&CurseTargetToken];[&GraphicOld_id]
   --^SKIP|
  
  --:AnnounceCurseEnd|token-id
   --#hidecard|0
   --#whisper|
   --#title|Hexblade Curse
   --#emotetext|[*[%1%]:t-name] is no longer cursed!
   --<|
  
  --:SKIP|
   --X|

  --/|Local helpers for optional character attrs (same logic as Farsidelib 1.5.2+ far_HasCharAttr / far_GetCharAttr / far_GetTokenCharAttr).
  --:HexHasCharAttr|character-id;attribute-name;return-var
   --&[%3%]|0
   --?"X[%1%]" -eq "X"|<|
   --~|array;attributes;AttrCheckList;[%1%];[%2%]
   --?[@AttrCheckList(length)] -ge 1|&[%3%];1
   --<|

  --:HexGetCharAttr|character-id;attribute-name;default-value;return-var
   -->HexHasCharAttr|[%1%];[%2%];AttrExistsFlag
   --?"X[&AttrExistsFlag]" -eq "X1"|[
    --&[%4%]|[*[%1%]:[%2%]]
   --]|[
    --&[%4%]|[%3%]
   --]|
   --<|

  --:HexGetTokenCharAttr|token-id;attribute-name;default-value;return-var
   --&[%4%]|[%3%]
   --?"X[*[%1%]:character_id]" -eq "X"|<|
   -->HexGetCharAttr|[*[%1%]:character_id];[%2%];[%3%];[%4%]
   --<|
}}