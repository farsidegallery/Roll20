!scriptcards {{
  +++5Elib;snlib;Farsidelib+++

  --#sourceToken|@{selected|token_id}
  --#reentrant|Ray of Frost @{selected|character_id}
  --#whisper|self,gm

  --/|Script Name : Ray of Frost
  --/|Version     : 1.2.0
  --/|Requires SC : ScriptCards Library 5Elib/snlib/Farsidelib; hpBar/tempHPbar and token markers via far_LoadTokenMarkers
  --/|Author      : Farsidegallery
  --/|
  --/|  Ranged spell attack cantrip. Scaling 1d8 cold (2014). On a hit, target's speed is reduced by 10 ft. until the start of your next turn.
  --/|  No Wild Magic Surge (2014: leveled sorcerer spells only).
  --/|

  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________

  --&SpellName|Ray of Frost
  --&MinimumSpellLevel|cantrip
  --&damageType|cold

  --/|What resource name is used for Sorcerer Points?
  --&SorcererResource|Sorcery Points

  --/|Put the name of your check if custom crit damage will be applied.
  --&CustomCritCheck|far_CustomCritCheck

  --/|Define your custom crit damage dice roll modifier, roll type, roll modifier, and extra damage modifier
  --&CritDamageDiceModifier|-1
  --&CritDamageDiceRollType|d
  --&CritDamageRollModifier|
  --=CritDamageModifier|+8

  --/|Are you using the matching Bardic Inspiration Script from FarsideGallery? (Default is No using 0. Change to 1 if using the script.)
  --=Scriptcheck|1

  --/| ____________________ End Global User Variables ___________________________________________________________________________________________

  --/|Helper variable build up to allow us to include a target prompt in an rbutton
  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[
  --&cbrac|]
  --&oparen|(
  --&cparen|)

  -->far_LoadTokenMarkers|

  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]

  --#title|[&SpellName]
  --#leftsub|Spell Level [&MinimumSpellLevel]
  --#rightsub|Range: [*R:spellrange]
  --&desc|[*R:spelldescription]
  -->LibSN_CHECK_STATUS_MARKER|[*S:t-id];[&InspirationMarker];InspiredFlag;InspiredCount
  -->LibSN_CHECK_STATUS_MARKER|[*S:t-id];[&BardicMarker];BardicFlag;BardicCount
  -->far_FIND_ACTIVE_GLOBAL_ATTACK_MODS|[*S:character_id];GlobalAttack
  -->LibSN_CHECK_STATUS_MARKER|[*S:t-id];[&BaneMarker];BaneMarkerFlag;BaneMarkerCount

  -->far_FIND_CLASS_LEVEL|[*S:character_id];Sorcerer;SLevel
  --?"X[&SLevel]" -eq "X0"|Target
  -->far_FindFeat|[*S:character_id];"Metamagic: Twinned Spell";TwinFeatFlag
  -->far_FindFeat|[*S:character_id];"Metamagic: Empowered Spell";EmpowerFeatFlag
  --=EmpowerDice|[*S:charisma_mod]
  --=SorceryPoints|0
  --=ChangeCount|0

  -->Lib5E_FIND_RESOURCE|[*S:character_id];[&SorcererResource];Pointsname;PointsAmmo
  --?"[&MinimumSpellLevel(toLowerCase)]" -eq "cantrip"|=TwinCost;1|=TwinCost;[$SpellLevel]\2 {MIN:1}
  --?"X[$TwinFeatFlag]" -ne "X1"|Target
  --?"X[$PointsAmmo]" -le "X0" -or "[&Pointsname]" -eq "Not Found" -or [$PointsAmmo] -lt [$TwinCost]|Target

  --+|[c]Do you want to spend [$TwinCost.Raw] [&SorcererResource] to Twin the spell?[/c]
  --+|[c][rbutton]Yes::BuildTwinArray[/rbutton]  [rbutton]No::Target[/rbutton][/c]
  --X|

  --:BuildTwinArray|
  --=SorceryPoints|[$TwinCost]
  --=TwinFlag|1
  -->far_BuildTargetList|2
  -->far_BuildTargetArray|Targets;2;TargetString
  --?"X[&target1]" -ne "X" -and "X[&target2]" -ne "X" -and "[&target1]" -eq "[&target2]"|>DuplicateTwinTarget
  --?[@Targets(length)] -lt 2|>DuplicateTwinTarget
  -->TargetArray|

  --:DuplicateTwinTarget|
  --+|[c][b]Twinned [&SpellName] requires two different creatures. Please select two different targets.[/b][/c]
  --^BuildTwinArray|

  --:Target|
  --+Target|[rbutton]Click this button to select your target.::SingleTarget;[&TB]target|token_id}[/rbutton]
  --X|

  --:SingleTarget|
  --&SingleTarget|[&reentryval]
  --~|array;define;Targets;[&SingleTarget]
  -->TargetArray|

  --:TargetArray|
  --?[@Targets(length)] -eq 0|>far_FatalError;No Target Selected;ERROR;Select a target before casting [&SpellName].
  -->TargetInfo|

  --:TargetInfo|
  --%target|foreach;Targets
   --#targettoken|[&target]
   --#emoteText|[*S:t-name] casts [&SpellName] at [*T:t-name]!
   --?[*T:npc] -eq 1|=TargetAC;[*T:npc_ac]|=TargetAC;[*T:ac]
   -->far_CheckDamageModifiers|[*T:character_id];[&damageType];damageMod[*T:t-id];0;0;0
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&HexMarker];HexMarkerFlag[*T:t-id];HexMarkerCount
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&HexBladeMarker];HexBladeMarkerFlag[*T:t-id];HexBladeMarkerCount

   --+|[c]Choose Attack Type:[/c]
   --+|[c][rbutton]Advantage::AttackType;2d20kh1[/rbutton][rbutton]Normal::AttackType;1d20[/rbutton][rbutton]Disadvantage::AttackType;2d20kl1[/rbutton][/c]
   --X|

  --:AttackType|
   --&AttackDice[*T:t-id]|[&reentryval]
   --?[&InspiredFlag] -ne 0|>far_Inspiration;[*S:t-id];[&InspirationMarker];[&AttackDice[*T:t-id]];AttackDice[*T:t-id]
   --c[&AttackDice[*T:t-id]]|2d20kh1:&DisplayDice[*T:t-id];Advantage|1d20:&DisplayDice[*T:t-id];1d20|2d20kl1:&DisplayDice[*T:t-id];Disadvantage

   --=AttackDiceBase[*T:t-id]|[&AttackDice[*T:t-id]]
   --=AttackRollMod|[$AttackDiceBase[*T:t-id]] + [*S:spell_attack_bonus] [Spell Attack Bonus]

   --?[&BardicFlag] -eq 1|>far_Bardic;[*S:t-id];[&BardicMarker];[$Scriptcheck];[$AttackDiceBase[*T:t-id]];[$AttackRollMod[*T:t-id]];BardRoll
   --?[&BaneMarkerFlag] -eq 1|&Baneroll;+ - 1d4 [Bane]|&Baneroll;

   --=AttackRoll[*T:t-id]|[$AttackDiceBase[*T:t-id]] + [*S:spell_attack_bonus] [Spell Attack Bonus] [&GlobalAttack] [&Baneroll] [&BardRoll]

   --?[$AttackDiceBase[*T:t-id]] -eq 20|>Crit
   --?[$AttackDiceBase[*T:t-id]] -eq 19 -and "X[*T:CurseCaster]" -eq "X[*S:t-id]"|>Crit
   --?[$AttackDiceBase[*T:t-id]] -eq 1|>Fumble
   --?[$AttackRoll[*T:t-id]] -ge [$TargetAC.Total] -and [$AttackDiceBase[*T:t-id]] -nei 20|>Hit
   --?[$AttackRoll[*T:t-id]] -lt [$TargetAC.Total] -and [$AttackDiceBase[*T:t-id]] -nei 1|>Miss
   --X|

  --:BottomForEachTarget|
  --%|
  -->Output|

  --/| ____________________ Procedures_______________________________________________________________________________________

  --:Crit|
   -->DamageRoll|
   --&GlobalDamage|
   -->far_FIND_ACTIVE_GLOBAL_DAMAGE_MODS|[*S:character_id];GlobalDamage;1;[*T:character_id]
   --?"X[&HexMarkerFlag[*T:t-id]]" -eq "X1" -and "X[*S:ConcentrationSpellTargetToken]" -eqi "X[*T:t-id]"|&Hex[*T:t-id]; + 1d6 [Hex]|&Hex[*T:t-id];
   --?"X[&HexBladeMarkerFlag[*T:t-id]]" -eq "X1" -and "X[*T:CurseCaster]" -eq "X[*S:t-id]"|&HexBlade[*T:t-id]; + [*S:pb] [Hexblade Curse]|&HexBlade[*T:t-id];
   -->[&CustomCritCheck]|CustomCritFlag
   --?[&CustomCritFlag] -eq 1|[
    --=CritDice|[&DamageDice]+[&CritDamageDiceModifier]
    --&CritDamage|[$CritDice][&CritDamageDiceRollType]8[&CritDamageRollModifier] + [$CritDamageModifier]
    --=Damage[*T:t-id]|[&DamageDice]d8 [Hit] + [&CritDamage] [Crit] [&damageMod[*T:t-id]] [&HexBlade[*T:t-id]] [&Hex[*T:t-id]] [&GlobalDamage]
   --]|[
    --=Damage[*T:t-id]|[&DamageDice]d8 [Hit] + [&DamageDice]d8 [Crit] [&damageMod[*T:t-id]] [&HexBlade[*T:t-id]] [&Hex[*T:t-id]][&GlobalDamage]
   --]|
   --?"X[$EmpowerFeatFlag]" -eq "X1" -and "[&damageMod[*T:t-id]]" -ninc "Immune"|>far_EmpowerSelect;Damage[*T:t-id];Crit;DamageChangedFlag[*T:t-id];ChangedDamage[*T:t-id]
   --?"X[$DamageChangedFlag[*T:t-id]]" -eq "X1"|[
    --=Damage[*T:t-id]|[$ChangedDamage[*T:t-id]] [&damageMod[*T:t-id]] [&HexBlade[*T:t-id]] [&Hex[*T:t-id]][&GlobalDamage]
    --=EmpoweredDamageFlag|1
   --]|
   --&ResultLabel[*T:t-id]|[b]Critical Hit!!![/b]
   --?"[&damageMod[*T:t-id]]" -inc "Immune"|[
    --=Damage[*T:t-id];0
    --&ResultText[*T:t-id]|[*T:t-name] is immune to [&damageType] damage.
    --]|[
    --&ResultText[*T:t-id]|The bolt did [$Damage[*T:t-id]] points of [&damageType] damage.
    --&ResultText2[*T:t-id]|[*T:t-name]'s speed is reduced by 10 ft. until the start of [*S:t-name]'s next turn.
    --]|
   --?"X[$Damage[*T:t-id].Total]" -gt "X0"|[
    -->far_DamageTokenmod|[*T:t-id];[&hpBar];[&tempHPbar];-[$Damage[*T:t-id]];0;0;1
    --=FinalHP[*T:t-id]|[*T:t-bar[&hpBar]_value]+[*T:t-bar[&tempHPbar]_value]
    --?[$FinalHP[*T:t-id]] -le 0|>Died
   --]|
   --^BottomForEachTarget|

  --:Hit|
   -->DamageRoll|
   --&GlobalDamage|
   -->far_FIND_ACTIVE_GLOBAL_DAMAGE_MODS|[*S:character_id];GlobalDamage;0;[*T:character_id]
   --?"X[&HexMarkerFlag[*T:t-id]]" -eq "X1" -and "X[*S:ConcentrationSpellTargetToken]" -eqi "X[*T:t-id]"|&Hex[*T:t-id]; + 1d6 [Hex]|&Hex[*T:t-id];
   --?"X[&HexBladeMarkerFlag[*T:t-id]]" -eq "X1" -and "X[*T:CurseCaster]" -eq "X[*S:t-id]"|&HexBlade[*T:t-id]; + [*S:pb] [Hexblade Curse]|&HexBlade[*T:t-id];
   --=Damage[*T:t-id]|[&DamageDice]d8 [&damageMod[*T:t-id]] [&HexBlade[*T:t-id]] [&Hex[*T:t-id]][&GlobalDamage]
   --?"X[$EmpowerFeatFlag]" -eq "X1" -and "[&damageMod[*T:t-id]]" -ninc "Immune"|>far_EmpowerSelect;Damage[*T:t-id];Hit;DamageChangedFlag[*T:t-id];ChangedDamage[*T:t-id]
   --?"X[$DamageChangedFlag[*T:t-id]]" -eq "X1"|[
    --=Damage[*T:t-id]|[$ChangedDamage[*T:t-id]] [&damageMod[*T:t-id]] [&HexBlade[*T:t-id]] [&Hex[*T:t-id]][&GlobalDamage]
    --=EmpoweredDamageFlag|1
    --]|
   --&ResultLabel[*T:t-id]|[b]Hit![/b]
   --?"[&damageMod[*T:t-id]]" -inc "Immune"|[
    --=Damage[*T:t-id]|0
    --&ResultText[*T:t-id]|[*T:t-name] is immune to [&damageType] damage.
    --]|[
    --&ResultText[*T:t-id]|The bolt did [$Damage[*T:t-id]] points of [&damageType] damage.
    --&ResultText2[*T:t-id]|[*T:t-name]'s speed is reduced by 10 ft. until the start of [*S:t-name]'s next turn.
    --]|
   --?"X[$Damage[*T:t-id].Total]" -gt "X0"|[
    -->far_DamageTokenmod|[*T:t-id];[&hpBar];[&tempHPbar];-[$Damage[*T:t-id]];0;0;1
    --=FinalHP[*T:t-id]|[*T:t-bar[&hpBar]_value]+[*T:t-bar[&tempHPbar]_value]
    --?[$FinalHP[*T:t-id]] -le 0|>Died
   --]|
   --^BottomForEachTarget|

  --:Miss|
   --&ResultLabel[*T:t-id]|[b]Missed![/b]
   --&ResultText[*T:t-id]|So close but they ducked just in time. Better luck next time (if there is a next time).
   --^BottomForEachTarget|

  --:Fumble|
   --&ResultLabel[*T:t-id]|[b]Critical Fail!!![/b]
   --&ResultText[*T:t-id]|The attack went horribly wrong.
   --^BottomForEachTarget|

  --:FailTable|
   --=Fail|[T#Damage-Spell-Fail]
   --&failText|[$Fail.tableEntryText]
   --?"[&failText]" -inc "[&obrac][&obrac]"|[
    --~failText1|string;before;[&obrac][&obrac];[&failText]
    --~failText2|string;after;[&cbrac][&cbrac];[&failText]
    --~roll|string;before;[&cbrac][&cbrac];[&failText]
    --~roll|string;after;[&obrac][&obrac];[&roll]
    --=failRoll|[&roll]
    --&failText|[&failText1][$failRoll][&failText2]
   --]|
   --+|[br]
   --+|[&failText]
   --?"[&failText]" -inc "Roll for damage"|[
    -->DamageRoll|
    --=Damage|[&DamageDice]d8
    --+|[br]
    --+Damage: |[$Damage]
   --]|
   --<|

  --:Died|
   --#whisper|
   --?"X[*T:CurseCaster]" -ne "X"|>HexHeal
   --~|turnorder;removetoken;[*T:t-id]
   --?"X[&HexMarkerFlag[*T:t-id]]" -eq "X1" -and "X[*S:ConcentrationSpellTargetToken]" -eqi "X[*T:t-id]"|[
    -->LibSN_REMOVE_STATUS_MARKER|[*T:t-id];[&HexMarker];0
    -->LibSN_REMOVE_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];0
   --]|
   --?"X[&HexBladeMarkerFlag[*T:t-id]]" -eq "X1" -and "X[*T:CurseCaster]" -eq "X[*S:t-id]"|[
    -->LibSN_REMOVE_STATUS_MARKER|[*T:t-id];[&HexBladeMarker];0
   --]|
   -->LibSN_ADD_STATUS_MARKER|[*T:t-id];[&DeathMarker]
   --<|

  --:HexHeal|
   -->far_HexHeal|[*T:t-id]
   --<|

  --:DamageRoll|
   --?[*S:level] -ge 17|&DamageDice;4
   --?[*S:level] -lt 17 -and [*S:level] -ge 11|&DamageDice;3
   --?[*S:level] -lt 11 -and [*S:level] -ge 5|&DamageDice;2
   --?[*S:level] -lt 5|&DamageDice;1
   --<|

  --:Output|
   --#whisper|
   --?"X[$TwinFlag]" -eq "X1"|[
    --#emoteText|[*S:t-name] Twins [&SpellName] to attack multiple targets!
   --]|

   --%loop|foreach;Targets
    --#targettoken|[&loop]
    -->far_PlayEffects|[*S:t-id];[*T:t-id];burn-magic;burst-frost;
    --+|[c][b]Target: [*T:t-name][/b][/c]
    --+Rolling [&DisplayDice[*T:t-id]]: |[$AttackDiceBase[*T:t-id]]
    --+Total Attack Roll: |[$AttackRoll[*T:t-id]]
    --+|[br]
    --+[&ResultLabel[*T:t-id]]: |[&ResultText[*T:t-id]]
    --?"X[&ResultText2[*T:t-id]]" -ne "X"|[
     --+|[&ResultText2[*T:t-id]]
    --]|
    --+|[br]
    --?"[&ResultLabel[*T:t-id]]" -inc "Critical Fail"|>FailTable
   --%|

   --+|[br]
   --+Desc: |[&desc]

   --?"X[$EmpoweredDamageFlag]" -eq "X1" -or "X[$TwinFlag]" -eq "X1"|[
    --=FinalPointsAmmo|[$PointsAmmo]-[$SorceryPoints]
    --!a:[*S:character_id]|[&PointsAmmo]:[$FinalPointsAmmo]
    --+|[br]
    --+|[&SorcererResource]: |Used: [$SorceryPoints] / Remaining: [$FinalPointsAmmo]
   --]|
   --X|

}}