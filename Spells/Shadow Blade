!scriptcard {{
  +++5Elib;snlib;Farsidelib+++

  --#sourceToken|@{selected|token_id}
  --#reentrant|Shadow Blade @{selected|character_id}
  --#whisper|self,gm

  --/|Script Name : Shadow Blade
  --/|Version     : 1.0
  --/|Author      : Farsidegallery
  --/|Description : Creates the Shadow Blade spell effect, deducts a 2nd-level spell slot, and sets concentration.

  --&SpellName|Shadow Blade
  --&MinimumSpellLevel|2
  --&ConcentrationMarker|Concentrating::7409928
  --&SpellDuration|Concentration, up to 1 minute
  --&SpellDesc|You weave together shadow to create a sword of solidified gloom in your hand. The blade deals 2d8 psychic damage on a hit, has finesse, light, and thrown (20/60) properties, and grants advantage on attack rolls in dim light or darkness.
  --&SpellUsage|Attack with the blade as a simple melee weapon using Strength or Dexterity for attack and damage rolls.
  --&HigherLevels|The spell has no additional effect when cast using a higher-level spell slot.

  --#title|[&SpellName]
  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
  -->far_GetAvailableSpellLevels|[*S:character_id];[&MinimumSpellLevel];SpellCastLevel
  --?[@SpellCastLevel(length)] -eq 0|>far_FatalError;No Spell Slots Available;ERROR;No spell slots are available to cast [&SpellName]

  --+Choose Function: |[rbutton]Cast Spell::New[/rbutton][rbutton]Dismiss::Remove[/rbutton]
  --X|

  --:New|
   --+|[c][b]Cast Shadow Blade[/b][/c]
   --#leftsub|1 bonus action
   --#rightsub|Self
   --+|Spell Level: 2
   --+|Duration: [&SpellDuration]
   --+|Damage: 2d8 psychic
   --+|Properties: finesse, light, thrown (20/60)
   --+|Advantage in dim light or darkness
   --+Desc: |[&SpellDesc]
   --+At Higher Levels: |[&HigherLevels]
   --!a:[*S:character_id]|!ConcentrationSpell:[&SpellName]
   -->LibSN_ADD_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];10
   -->far_DeductSpellSlot|[*S:t-id];[&MinimumSpellLevel]
   --#emoteText|[*S:character_name] weaves a Shadow Blade!
   --#whisper|
    --+|[b]Shadow Blade[/b] has been cast.
    --+|[&SpellUsage]
    --+|[br]
    --+|[&SpellDesc]
   --X|

  --:Remove|
   --#emoteText|[*S:character_name] ends Shadow Blade.
   --#whisper|
    --+|[b]Shadow Blade[/b] ends.
   -->LibSN_REMOVE_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker]
   --!a:[*S:character_id]|!ConcentrationSpell:**
   --X|
}}
