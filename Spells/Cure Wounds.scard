!scriptcards {{
  +++5Elib;snlib;Farsidelib+++	
  
 --#sourceToken|@{selected|token_id}
 --#reentrant|My Cool Script @{selected|character_id}
 --#whisper|self,gm

  --/|Script Name : Cure Wounds
  --/|Version     : 2.1.1
  --/|Requires SC : TokenMod, SuperNotes (for template override only), ScriptCards Library 5Elib/snlib/Farsidelib
  --/|Author      : 
  --/|Modified By : Farsidegallery
  --/|
  --/|  Script prompts user for spell level used and then queries target to be healed. It will deduct 1 spell slot from the appropriate level. 
  --/|  Script checks for Disciple of Life and Belssed Healer feats. It checks if Beacon of Hope is active, calculates, and applies healing to the target.
  --/|
  
  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________
      
   --&SpellName|Cure Wounds
   --&MinimumSpellLevel|1

   --&hpBar|1
   --&tempHPbar|4
   
   --&attrib|dexterity

   --/|What resource name is used for Sorcerer Points?
   --&SorcererResource|Sorcery Points
   
   --/|Do you use a token marker for Beacon of Hope? (0 for no (default) or 1 for yes)
   --=BeaconFlag|1
  
  --/| ____________________ End Global User Variables ___________________________________________________________________________________________

  --/|Helper variable build up to allow us to include a target prompt in an rbutton
  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[ 
  --&cbrac|]
  --&oparen|(
  --&cparen|)

  -->far_LoadTokenMarkers|

  --#title|[&SpellName]
  --#emoteText|[*S:character_name] Casts Cure Wounds on [*T:character_name]

  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
  -->far_GetAvailableSpellLevels|[*S:character_id];[&MinimumSpellLevel];SpellCastLevel
  --?[@SpellCastLevel(length)] -eq 0|>far_FatalError;No Spell Slots Available;ERROR;No spell slots are available to cast [&SpellName]

  
  --+|[c][b]Cast At What Level?[/b][/c]
    --&splvlMsg|
    --%splvl|foreach;SpellCastLevel
     --&splvlMsg|+ [rbutton][&splvl]::ChooseType;[&splvl][/rbutton]
    --%|
  --+|[c][&splvlMsg][/c]
  --X|
  
  --:ChooseType|
   --=SpellLevel|[&reentryval]
   --&SpellLevel|[&reentryval]
   
   --#leftsub|Spell Level [&MinimumSpellLevel]
   --#rightsub|[*R:range]
   --?[*R:spellconcentration] -inc 1|&duration;[*R:spellduration] [b](Concentration)[/b]|&duration;[*R:spellduration]
   --&desc|[*R:spelldescription]
   --&higherdesc|[*R:spellathigherlevels]

   -->far_FIND_CLASS_LEVEL|[*S:character_id];Sorcerer;SLevel
   --?"X[&SLevel]" -eq "X0"|Target
   -->far_FindFeat|[*S:character_id];"Metamagic: Twinned Spell";TwinFeatFlag
   -->far_FindFeat|[*S:character_id];"Metamagic: Empowered Spell";EmpowerFeatFlag
   -->far_FindFeat|[*S:character_id];"Wild Magic Surge";WildFeatFlag
   --=EmpowerDice|[*S:charisma_mod]
   --=SorceryPoints|0
   --=ChangeCount|0
   -->AbilityAssign|[*S:spellcasting_ability];ModHealing
   
   -->Lib5E_FIND_RESOURCE|[*S:character_id];[&SorcererResource];Pointsname;PointsAmmo
   --?"[&MinimumSpellLevel(toLowerCase)]" -eq "cantrip"|=TwinCost;1 |=TwinCost;[$SpellLevel]\2 {MIN:1}
   --?"X[$PointsAmmo]" -le "X0" -or "[&Pointsname]" -eq "Not Found" -or [$PointsAmmo] -lt [$TwinCost]|Target

   --+|[c]Do you want to spend [$TwinCost.Raw] [&SorcererResource] to Twin the spell?[/c]
   --+|[c][rbutton]Yes::BuildTwinArray[/rbutton]  [rbutton]No::Target[/rbutton][/c]
   --X|

  --:BuildTwinArray|
   --=SorceryPoints|[$TwinCost]
   --=TwinFlag|1
   -->far_BuildTargetList|2
   -->far_BuildTargetArray|Targets;2;TargetString
   -->TargetInfo|
  
  --:Target|
   -->far_FindFeat|[*S:t-id];Disciple of Life;LifeFlag
   -->far_FindFeat|[*S:t-id];Blessed Healer;HealerFlag
   -->AbilityAssign|[*S:spellcasting_ability];ModHealing

   --+Target|[rbutton]Click this button to select your target.::SingleTarget;[&TB]target|token_id}[/rbutton]
   --X|

  --:SingleTarget|
   --&SingleTarget|[&reentryval]
   --~|array;define;Targets;[&SingleTarget]
   -->TargetInfo|
  
  --:TargetInfo|
   --%target|foreach;Targets
    --#targettoken|[&target]
    -->far_PlayEffects|[*S:t-id];[*T:t-id];burn-magic;burst-holy;;;
    -->FindHopeBeacon|[*T:t-id]
    -->Heal|
    --+|[br]
    --%|
    
   --?[$HealerFlag] -eq 1|[
    --=SelfHeal|[$SpellLevel] [Spell Level] + 2 [Blessed Healer]
	 --+Blessed Healer: |[*S:character_name] self heals for [$SelfHeal] hp.
	 -->LibSN_APPLY_DAMAGE_OR_HEALING|[*S:t-id];1;[$SelfHeal];0;0
	 --]|
   
   --?"X[$WildFeatFlag]" -eq "X1" -and [&MinimumSpellLevel] -ge 1|>far_WildTable
   
   --+Desc: |[*R:spelldescription]
   --+At Higher Levels: |[*R:spellathigherlevels]
   -->far_DeductSpellSlot|[*S:t-id];[$SpellLevel]

   --?"X[$EmpoweredDamageFlag]" -eq "X1" -or "X[$TwinFlag]" -eq "X1"|[
    --=FinalPointsAmmo|[$PointsAmmo]-[$SorceryPoints]
    --!a:[*S:character_id]|[&PointsAmmo]:[$FinalPointsAmmo]
    --+|[br]
	  --+[&SorcererResource]: |Used: [$SorceryPoints] / Remaining: [$FinalPointsAmmo]
    --]|
   --X|  

--/| ____________________ Procedures_______________________________________________________________________________________

  --:FindHopeBeacon|TargetID
   --/|Check Global Setting if Beacon of Hope has a Token Marker
   --?[$BeaconFlag] -eq 0|[
	 --iIs Beacon of Hope active?;Click this button to choose.|q;response;Choose|Yes|No
     --c[&response]|Yes:=Beacon;1|No:=Beacon;0
	--]|
   --?[$BeaconFlag] -eq 1|[
	 -->LibSN_CHECK_STATUS_MARKER|[%1%];[&BeaconMarker];BeaconStatus
	 --?[&BeaconStatus] -eq 1|=Beacon;1|=Beacon;0
	--]|
   --<|
  
  --:Heal|TargetID
   --#whisper|
   --=HPCalc|[$SpellLevel]
   --c[$LifeFlag]|0:&Disciple; |1:&Disciple;+ [2 + [$SpellLevel]] [Disciple of Life]
   --c[$Beacon]|0:=Dice;[$HPCalc]d8 |1:=Dice;[$HPCalc] * 8
   --=HPRecovered|[$Dice] + [$ModHealing] [[&Displayattrib] Mod]  [&Disciple]
   --+Rolling: |[$HPCalc.Text]d8 = [$Dice]
   --+Total Healing:|[*S:t-name] heals [$HPRecovered] hit points.
   --=Missing|[*T:hp^] - [*T:hp]
   --?[$HPRecovered] -gt [$Missing]|=HealAmount;[$Missing]|=HealAmount;[$HPRecovered]
   -->LibSN_APPLY_DAMAGE_OR_HEALING|[*T:t-id];[&hpBar];[$HealAmount];0;0;0
   --+Amount Healed:|[*T:t-name] regains [$HealAmount] hit points.
   --<|
   
  --:AbilityAssign|SpellAbility
   --&Attribute|[%1%]
   --~Attribute|string;after;{;[&Attribute]
   --~Attribute|string;before;_;[&Attribute]
   --=[%2%]|[*S:[&Attribute]_mod]
   --~shortattrib|string;left;3;[&Attribute]
   --~Displayattrib|string;touppercase;[&shortattrib]
   --<|
}}