!scriptcards {{
  +++5Elib;snlib;Farsidelib+++

  --/|Script Name : Shield of Faith
  --/|Version     : 2.1.1
  --/|Modified By : Farsidegallery
  --/|
  --/|  Applies +2 AC global mod to target(s), concentration on caster, optional FX graphic. Sorcerer Twin/Wild Magic supported.
  --/|

  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________

  --/|What is the name of the Global AC Mod used for Shield of Faith.
  --&FaithMod|Shield of Faith

  --&SpellName|Shield of Faith
  --&MinimumSpellLevel|1

  --/|Enter name for Shield of Faith Character.
  --&CharName|Shield of Faith

  --/|What resource name is used for Sorcerer Points?
  --&SorcererResource|Sorcery Points

  --&URLlink|https://files.d20.io/images/466427878/d3CEuElOj687McxkWbS8Cw/med.webm?1764785094

  --/| ____________________ End Global User Variables ___________________________________________________________________________________________

  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[
  --&cbrac|]
  --&oparen|(
  --&cparen|)

  --#title|[&SpellName]
  --#sourceToken|@{selected|token_id}
  --#reentrant|Shield of Faith @{selected|character_id}
  --#whisper|self,gm

  -->far_LoadTokenMarkers|

  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]

  --=SpellLevel|1
  --#leftsub|[*R:spellcastingtime]
  --#rightsub|[*R:spellrange]
  --&spelldesc|[*R:spelldescription]
  --?[*R:spellconcentration] -inc 1|&duration;[*R:spellduration] [b](Concentration)[/b]|&duration;[*R:spellduration]

  --+Choose Function: |[rbutton]New Cast::New[/rbutton][rbutton]Dismiss::Remove[/rbutton]
  --X|

  --:New|
  --?"X[*S:ConcentrationSpell]" -eq "X[&SpellName]"|>far_FatalError;Already Concentrating;ERROR;Dismiss [&SpellName] before casting again.

  --=TwinFlag|0
  --=SorceryPoints|0
  --=WildFeatFlag|0
  -->far_FIND_CLASS_LEVEL|[*S:character_id];Sorcerer;SLevel
  --?"X[&SLevel]" -eq "X0"|>Target
  -->far_FindFeat|[*S:character_id];"Metamagic: Twinned Spell";TwinFeatFlag
  -->far_FindFeat|[*S:character_id];"Wild Magic Surge";WildFeatFlag
  -->Lib5E_FIND_RESOURCE|[*S:character_id];[&SorcererResource];Pointsname;PointsAmmo
  --?"X[$TwinFeatFlag]" -ne "X1"|>Target
  --?"X[$PointsAmmo]" -le "X0" -or "[&Pointsname]" -eq "Not Found"|>Target
  --+|[c]Do you want to spend 1 [&SorcererResource] to Twin the spell?[/c]
  --+|[c][rbutton]Yes::TwinTarget[/rbutton]  [rbutton]No::Target[/rbutton][/c]
  --X|

  --:TwinTarget|
  --=TwinFlag|1
  --=SorceryPoints|1
  -->far_BuildTargetList|2
  -->far_BuildTargetArray|Targets;2;TargetString
  -->TargetInfo|

  --:Target|
  --+Target|[rbutton]Click here to select your target.::TargetArray;[&TB]target|token_id}[/rbutton]
  --X|

  --:TargetArray|
  --&SingleTarget|[&reentryval]
  --~|array;define;Targets;[&SingleTarget]
  -->TargetInfo|

  --:TargetInfo|
  --~|array;define;FaithTargets
  --~|array;define;FaithGraphics
  --&PrimaryTarget|
  --%target|foreach;Targets
   --#targettoken|[&target]
   --?"X[&PrimaryTarget]" -eq "X"|&PrimaryTarget;[&target]
   -->ApplyFaithToTarget|
  --%|
  --?[@FaithTargets(length)] -eq 0|>far_FatalError;No Targets;ERROR;No valid targets were selected for [&SpellName].
  -->Finish|

  --:ApplyFaithToTarget|
  -->CheckForMod|
  -->SpawnFaithGraphic|
  --~|array;add;FaithTargets;[&target]
  --?"X[&ShieldTID]" -ne "X"|[
   --~|array;add;FaithGraphics;[&ShieldTID]
  --]|
  --+|[*[&target]:t-name] gains +2 AC from [&SpellName].
  --+|[br]
  --<|

  --:CheckForMod|
  --&_FarGMName|[&FaithMod]
  -->far_Check_GLOBAL_MOD_EXISTS|[*T:character_id];ac;;Exists
  --?"X[&Exists]" -eq "X1"|>SoF_SetMod |>SoF_CreateMod
  --<|

  --:SoF_CreateMod|
  --!a:[*T:character_id]|global_ac_mod_flag:1
  --!or:[*T:character_id]:acmod|
   global_ac_name:[&FaithMod]|
   global_ac_val:2|
   global_ac_active_flag:1|
   options-flag:0|
  -->SoF_SetMod|

  --:SoF_SetMod|
  -->Lib5E_SET_GLOBAL_MOD_STATUS|[*T:character_id];ac;[&FaithMod];1
  -->far_PlayEffects|[*S:t-id];[*T:t-id];;burn-holy
  -->far_GetJournalCharIdByName|[&CharName];ShieldID
  --<|

  --:SpawnFaithGraphic|
  --&ShieldTID|
  --&TokenName|[*[&target]:t-name] [&SpellName]
  --?"X[&ShieldID]" -eq "X"|>far_FatalError;FX Setup;ERROR;Create a journal character named [&CharName] for Shield of Faith graphics
  --!ot:ShieldTID|name:"[&TokenName]"|_pageid:[*T:t-_pageid]|left:[*T:t-left]|top:[*T:t-top]|width:[=[*T:t-width]*3]|height:[=[*T:t-height]*3]|imgsrc:"[&URLlink]"|bar1_value:1|represents:[&ShieldID]|showname:1
  --?"X[&ShieldTID]" -eq "X"|[
   -->far_FindPageTokenByName|[*T:t-id];[&TokenName];ShieldTID
  --]|
  --?"X[&ShieldTID]" -ne "X"|[
   --z:graphic:[&ShieldTID]|toback
   --@CARRY_TOKENS_CARRY_BELOW|[*T:t-id] [&ShieldTID]
  --]|
  --<|

  --:Finish|
  -->far_GetAndCheckSlotInformation|[*S:t-id];[$SpellLevel]
  --#whisper|
  --?"X[$WildFeatFlag]" -eq "X1"|>far_WildTable
  --!a:[*S:character_id]|!ConcentrationSpell:[&SpellName]
  --!a:[*S:character_id]|!ConcentrationSpellTargetToken:[&PrimaryTarget]
  --~FaithTargetString|array;stringify;FaithTargets;!@!
  --~FaithGraphicString|array;stringify;FaithGraphics;!@!
  --!a:[*S:character_id]|!FaithShieldTargets:[&FaithTargetString]
  --!a:[*S:character_id]|!FaithShieldGraphics:[&FaithGraphicString]
  -->LibSN_ADD_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];10
  --#emoteText|[*S:t-name] casts [&SpellName]!
  --+Duration: |[&duration]
  --+Desc: |[&spelldesc]
  --+|[br]
  -->far_DeductSpellSlot|[*S:t-id];[$SpellLevel]
  --?"X[$TwinFlag]" -eq "X1"|[
   --=FinalPointsAmmo|[$PointsAmmo]-[$SorceryPoints]
   --!a:[*S:character_id]|[&PointsAmmo]:[$FinalPointsAmmo]
   --+|[br]
   --+|[&SorcererResource]: |Used: [$SorceryPoints] / Remaining: [$FinalPointsAmmo]
  --]|
  --X|

  --:Remove|
  -->far_LoadTokenMarkers|
  --#whisper|
  --#emoteText|[*S:t-name] is no longer concentrating on [&SpellName]!
  -->ClearFaithEffects|
  --+|The invisible barrier vanishes! AC returns to normal for affected creatures.
  --X|

  --/| ____________________ Procedures_______________________________________________________________________________________

  --:ClearFaithEffects|
  --?"X[*S:FaithShieldTargets]" -ne "X"|ClearFaithModsFromStored
  --?"X[*S:ConcentrationSpellTargetToken]" -ne "X"|ClearFaithModPrimary
  --^ClearFaithDeleteGraphics|

 --:ClearFaithModsFromStored|
  --~|array;fromstring;FaithTargets;!@!;[*S:FaithShieldTargets]
  --?[@FaithTargets(length)] -lt 1|^ClearFaithDeleteGraphics
  --%ClearFaithTgt|foreach;FaithTargets
   --#targettoken|[&ClearFaithTgt]
   -->ClearFaithModOnTarget|
   --^ClearFaithTgtNext|
  --:ClearFaithTgtNext|
  --%|
  --^ClearFaithDeleteGraphics|

 --:ClearFaithModPrimary|
  --#targettoken|[*S:ConcentrationSpellTargetToken]
  -->ClearFaithModOnTarget|
  --^ClearFaithDeleteGraphics|

 --:ClearFaithModOnTarget|
  -->Lib5E_SET_GLOBAL_MOD_STATUS|[*T:character_id];ac;[&FaithMod];0
  --<|

 --:ClearFaithDeleteGraphics|
  --?"X[*S:FaithShieldGraphics]" -ne "X"|ClearFaithGfxFromStored
  --^ClearFaithGfxFinish|

 --:ClearFaithGfxFromStored|
  --~|array;fromstring;FaithGraphics;!@!;[*S:FaithShieldGraphics]
  --?[@FaithGraphics(length)] -lt 1|^ClearFaithGfxFinish
  --%ClearFaithGfx|foreach;FaithGraphics
   --?"X[&ClearFaithGfx]" -eq "X"|^ClearFaithGfxNext
   --~|object;token;delete;[&ClearFaithGfx]
   --^ClearFaithGfxNext|
  --:ClearFaithGfxNext|
  --%|
  --^ClearFaithGfxFinish|

 --:ClearFaithGfxFinish|
  --?"X[*S:FaithShieldTargets]" -ne "X"|ClearFaithGfxByTargetNames
  --^ClearFaithAttrsFinish|

 --:ClearFaithGfxByTargetNames|
  --~|array;fromstring;FaithTargets;!@!;[*S:FaithShieldTargets]
  --?[@FaithTargets(length)] -lt 1|>ClearFaithAttrsFinish
  --%ClearFaithNameTgt|foreach;FaithTargets
   --#targettoken|[&ClearFaithNameTgt]
   --&TokenName|[*[&ClearFaithNameTgt]:t-name] [&SpellName]
   --~count|array;pagetokens;FaithFxTokens;[*T:t-id];tprop:name=[&TokenName]
   --?[@FaithFxTokens(length)] -gt 0|[
    --~|object;token;delete;[@FaithFxTokens(0)]
   --]|
  --%|
  --^ClearFaithAttrsFinish|

 --:ClearFaithAttrsFinish|
  -->LibSN_REMOVE_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];0
  --!a:[*S:character_id]|!ConcentrationSpell:**
  --!a:[*S:character_id]|!ConcentrationSpellTargetToken:**
  --!a:[*S:character_id]|!FaithShieldTargets:**
  --!a:[*S:character_id]|!FaithShieldGraphics:**
  --<|

}}