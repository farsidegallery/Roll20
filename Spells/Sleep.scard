!scriptcards {{
  +++5Elib;snlib;Farsidelib+++
  
  --#sourceToken|@{selected|token_id}
  --#reentrant|@{selected|character_id}_Sleep_Spell
  --#whisper|self,gm
  
  --/|Script Name : Sleep
  --/|Version     : 2.1.1
  --/|Modified By : Farsidegallery
  --/|  
  --/|  Slot check, spell template AoE, HP-pool sleep (lowest HP first). Undead, constructs, and charmed-immune skipped.
  --/|
  
  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________
  
  --&SpellName|Sleep
  --&MinimumSpellLevel|1

  --/|What resource name is used for Sorcerer Points?
  --&SorcererResource|Sorcery Points
  
  --&Sleep_Marker|Unconscious::7409935
  --&SleepChar|Sleep
  --&SleepLink|https://files.d20.io/images/466452653/fWh2Z4z8OtwxGOeorsnMCQ/med.webm?1764800273
  
  --/| Place the name and URL of your spell target token here.
  --&SpellTargetToken|Spell Token
  --&URLlink|https://files.d20.io/images/469753332/ew1SU1DcQK4eborJlOqNQw/original.png
  
  --/|Button Format
  --#buttonBackground|#4d1635
  --#buttonFontFace|Tahoma
  --#buttonFontSize|14px
  
  --#noMinMaxHighlight|1
  
  --&TokenProperty|bar1_value
  
  --/| ____________________ End Global User Variables ___________________________________________________________________________________________
  
  --/|Helper variable build up to allow us to include a target prompt in an rbutton
  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&brace|{
  --&cbrace|}
  --&obrac|[ 
  --&cbrac|]
  --&bang|!
  --&dash|-
  
  --#title|[&SpellName]
  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
  -->far_GetAvailableSpellLevels|[*S:character_id];[&MinimumSpellLevel];SpellCastLevel
  --?[@SpellCastLevel(length)] -eq 0|>far_FatalError;No Spell Slots Available;ERROR;No spell slots are available to cast [&SpellName]
  
  --+|[c][b]Cast At What Level?[/b][/c]
    --&splvlMsg|
    --%splvl|foreach;SpellCastLevel
     --&splvlMsg|+ [rbutton][&splvl]::ChooseType;[&splvl][/rbutton]
    --%|
  --+|[c][&splvlMsg][/c]
  --X|
  
  --:ChooseType|
   --=SpellLevel|[&reentryval]
   --&SpellLevel|[&reentryval]
   -->far_GetAndCheckSlotInformation|[*S:t-id];[$SpellLevel]

   -->far_FIND_CLASS_LEVEL|[*S:character_id];Sorcerer;SLevel
   --?"X[&SLevel]" -eq "X0"|Target
   -->far_FindFeat|[*S:character_id];"Wild Magic Surge";WildFeatFlag
   
   --:Target|
   --#leftsub|[*R:spellcastingtime]
   --#rightsub|[*R:spellrange]
   --#emotetext|[*S:character_name] casts [&SpellName] at Level [&SpellLevel]!
   --&spelldesc|[*R:spelldescription]
   --&spellhigherdesc|[*R:spellathigherlevels]
   --?[*R:spellconcentration] -inc 1|&duration;[*R:spellduration] [b](Concentration)[/b]|&duration;[*R:spellduration]
   --=SleepDice|[$SpellLevel]-1*2+5
   --=SleepPoints|[$SleepDice]d8
  
   -->GetMuleCharacterID|[&SpellTargetToken];AOETargetID
   -->GetMuleCharacterID|[&SleepChar];SleepCharID
  
   --&SelectedID|[*S:character_id]
  
  --:SpawnToken|
   --+|Move Spell Token to desired location and then target it by casting the spell.
   --!ot:NewTID|name:"[&SpellTargetToken]"|_pageid:[*S:t-_pageid]|left:[=[*S:t-left]+70]|top:[*S:t-top]|width:[*S:t-width]|height:[*S:t-height]|imgsrc:"[&URLlink]"|bar1_value:1|represents:[&AOETargetID]|showname:0|t-aura1_radius:20|t-aura1_color:#d0e0e3
   --z:graphic:[&NewTID]|tofront
   -->SetAbility|
  
  --:CAST_SPELL|
   --+Target: |[rbutton]Target the SpellToken.::SetTarget;[&TB]target|token_id}[/rbutton]
   --X|
  
  --:SetTarget|
   --#targettoken|[&reentryval]
   --&SleepTarget|[*T:t-id]
   --^AOE_SLEEP|
   
  --:AOE_SLEEP|
   --~|array;pagetokens;alltokens;[&SleepTarget]
   --~|array;define;inRange;
   --~tokenid|array;getfirst;alltokens
   --?[&tokenid] -eq ArrayError|Finish

  --:Sleep_loop|
   --?"[&tokenid]" -eq "[&SleepTarget]"|>Sleep_scanNext
   --?"[*[&tokenid]:t-name]" -eq "[&SpellTargetToken]"|>Sleep_scanNext
   --?[*[&tokenid]:t-layer] -ne objects|>Sleep_scanNext
   --?"[*[&tokenid]:t-represents]" -ninc "-"|>Sleep_scanNext
   --?"[*[&tokenid]:t-represents]" -eq "[&AOETargetID]"|>Sleep_scanNext
   --?"[*[&tokenid]:t-represents]" -eq "[&SleepCharID]"|>Sleep_scanNext
   --~dist|euclideanpixel;[&SleepTarget];[&tokenid]
   --?[$dist] -gt 280|>Sleep_scanNext
   --~|array;add;inRange;[*[&tokenid]:t-[&TokenProperty]],[&tokenid]

  --:Sleep_scanNext|
   --~tokenid|array;getnext;alltokens
   --?[&tokenid] -ne ArrayError|Sleep_loop
   --?"[@inRange()]" -eq "undefined array"|Finish
   --?[@inRange(length)] -le 0|Finish
   --/|Remove AoE spell token before sleep overlays + CARRY (Finish delete raced async carry).
   --?"X[&SleepTarget]" -ne "X"|[
    --~|object;token;delete;[&SleepTarget]
    --&SleepTarget|
   --]|
   --~|array;numericsort;inRange  
   -->Apply_Sleep|
   
   --/|Apply sleep if enough sleep points are left.
   --:Apply_Sleep|
    --#whisper|
	--&SleepToken|[*S:character_name] [&SleepChar]
	--+|[t border=3 width=100%][tr][td][c][$SleepDice.Raw]d8 Sleep Points: [$SleepPoints][/c][/td][/tr]
	--+|[t border=3 width=100%][tr][td style="width:175px"][c][b]Target[/b][/c][/td][td style="width:175px"][c][b]Result[/b][/c][/td][/tr]
	--%loop|foreach;inRange
	 --~hp|string;before;,;[&loop]
	 --~loop|string;after;,;[&loop]
	 --?"[&loop]" -eq "[&SleepTarget]"|>Sleep_nextInRange
	 --?"[*[&loop]:t-name]" -eq "[&SpellTargetToken]"|>Sleep_nextInRange
	 --&Type|"[*[&loop]:npc_type]"
	 --&Immune|"[*[&loop]:npc_condition_immunities]"
	 --=TokenHP|[&hp]
	 --?[&Type] -inc undead|[
	  --+|[t border=3 width=100%][tr][td style="width:175px"][*[&loop]:t-name][/td][td style="width:175px"][c]Undead[/c][/td][/tr]
	  -->Sleep_nextInRange|
	  --]|
	 --?[&Type] -inc construct|[
	  --+|[t border=3 width=100%][tr][td style="width:175px"][*[&loop]:t-name][/td][td style="width:175px"][c]Construct[/c][/td][/tr]
	  -->Sleep_nextInRange|
	  --]|
	 --?[&Immune] -inc charmed -and [&Type] -ninc undead|[
	  --+|[t border=3 width=100%][tr][td style="width:175px"][*[&loop]:t-name][/td][td style="width:175px"][c]Immune[/c][/td][/tr]
	  -->Sleep_nextInRange|
	  --]|
	 --?[$SleepPoints] -ge [$TokenHP] -and [&Type] -ninc undead -and [&Type] -ninc construct -and [&Immune] -ninc charmed|[
	  --&SleepCarrierId|[&loop]
	  --!ot:SleepOverlayTID|name:"[&SleepToken]"|_pageid:[*S:t-_pageid]|left:[*[&loop]:t-left]|top:[*[&loop]:t-top]|width:[=[*[&loop]:t-width]*2]|height:[=[*[&loop]:t-height]*2]|imgsrc:"[&SleepLink]"|bar1_value:1|represents:[&SleepCharID]|showname:0
	  --&SleepOverlayId|[&SleepOverlayTID]
	  --?"X[&SleepOverlayId]" -eq "X"|>Sleep_nextInRange
	  --?"[&SleepOverlayId]" -eq ""|>Sleep_nextInRange
	  --+|[t border=3 width=100%][tr][td style="width:175px"][*[&loop]:t-name][/td][td style="width:175px"][c]Slept[/c][/td][/tr]
	  -->LibSN_ADD_STATUS_MARKER_SET|[*[&loop]:t-id];[&Sleep_Marker]
	  --=SleepPoints|[$SleepPoints]-[$TokenHP]
	  --z:graphic:[&SleepOverlayId]|toback
	  --@CARRY_TOKENS_CARRY_BELOW|[&SleepCarrierId] [&SleepOverlayId]
	  --]|[
	  --+|[t border=3 width=100%][tr][td style="width:175px"][*[&loop]:character_name][/td][td style="width:175px"][c]No Effect[/c][/td][/tr]
	  --]|
	 --:Sleep_nextInRange|
	 --%|
	-->Finish|
  
  --:Finish|
   --#whisper|
   --~|hash;clear;Sleep
   --/|AoE spell token already deleted before Apply_Sleep; remove any leftover by name.
   --~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&SpellTargetToken]
   --?[@tokens(length)] -gt 0|[
    --~|object;token;delete;[@tokens(0)]
   --]|
   
   --?"X[$WildFeatFlag]" -eq "X1" -and [&MinimumSpellLevel] -ge 1|>far_WildTable
   
   --?[*R:spellconcentration] -inc 1|&duration;[*R:spellduration] [b](Concentration)[/b]|&duration;[*R:spellduration]
   --+Duration: |[&duration]
   --+Desc: |[*R:spelldescription]
   --+At Higher Levels: |[*R:spellathigherlevels]
   --+|[br]
   -->far_DeductSpellSlot|[*S:t-id];[$SpellLevel]
   --X|
  
  --:GetMuleCharacterID|MuleCharacterName;StringVariableForCharID
   --~|array;objects:character;MuleCharArr;[%1%]
   --?[@MuleCharArr(length)] -ne 1|>far_FatalError;Could not find mule character named [%1%];ERROR;Create a journal character named [%1%] for Sleep graphics
   --&[%2%]|[@MuleCharArr(0)]
