!scriptcards {{
  +++5Elib;snlib;Farsidelib+++

  --/|Script Name : Shield
  --/|Version     : 2.2.0
  --/|Modified By : Farsidegallery
  --/|
  --/|  Reaction spell: +5 AC global mod on self, FX graphics via ScriptCards, manual Dismiss. Wild Magic for sorcerers.
  --/|

  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________

  --/|What is the name of the Global AC Mod used for Shield.
  --&ModName|Shield Spell

  --&SpellName|Shield
  --&MinimumSpellLevel|1

  --/|Enter name for Shield Character (journal NPC for FX graphic).
  --&CharName|Shield Spell

  --/|Enter name for Reaction Used Character (journal NPC for FX graphic).
  --&ReactCharName|Reaction Used

  --&URLlink|https://files.d20.io/images/466430946/7DPjXj0n0IMCLlbLg50mPg/med.webm?1764787074

  --&link1|https://files.d20.io/images/476457994/FdbUAgAk_G-
  --&link2|-2d1MaQ9g4w/med.webm?1771472165
  --&Reactlink|[&link1][&link2]

  --/|2 = forselected Spawn (journal default token). 1 = ScriptCards !ot with URLlink/Reactlink.
  --&SpawnScript|1

  --/|Set to 1 to whisper carry IDs and the API command to GM/self before linking FX tokens.
  --&DebugCarry|0

  --/| ____________________ End Global User Variables ___________________________________________________________________________________________

  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[
  --&cbrac|]
  --&oparen|(
  --&cparen|)

  --#title|[&SpellName]
  --#sourceToken|@{selected|token_id}
  --#reentrant|Shield @{selected|character_id}
  --#whisper|self,gm

  -->far_LoadTokenMarkers|

  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
  --=SpellLevel|[&MinimumSpellLevel]
  --+Choose Function: |[rbutton]New Cast::CheckForMod[/rbutton][rbutton]Dismiss::Remove[/rbutton]
  --X|

 --:CheckForMod|
  --#leftsub|[*R:spellcastingtime]
  --#rightsub|[*R:spellrange]
  --&spelldesc|[*R:spelldescription]
  --&duration|[*R:spellduration]
  --&TokenName|[*S:character_name] [&SpellName]
  --&ReactTokenName|[*S:character_name] [&ReactCharName]
  
  -->Lib5E_GET_GLOBAL_MOD_STATUS|[*S:character_id];ac;[&ModName];IsActive
  --?"X[&IsActive]" -eq "X1"|>far_FatalError;Shield Active;ERROR;Dismiss [&SpellName] before casting again.
  
  -->far_GetAndCheckSlotInformation|[*S:t-id];[$SpellLevel]
  
  --=WildFeatFlag|0
  -->far_FIND_CLASS_LEVEL|[*S:character_id];Sorcerer;SLevel
  --?"X[&SLevel]" -eq "X0"|>ApplyMod
  -->far_FindFeat|[*S:character_id];"Wild Magic Surge";WildFeatFlag
  -->ApplyMod|

 --:ApplyMod|
  -->far_Check_GLOBAL_MOD_EXISTS|[*S:character_id];ac;[&ModName];Exists
  --?"X[&Exists]" -eq "X1"|>SetMod |>CreateMod
  --<|

 --:CreateMod|
  --!a:[*S:character_id]|global_ac_mod_flag:1
  --!or:[*S:character_id]:acmod|
     global_ac_name:[&ModName]|
     global_ac_val:5|
     global_ac_active_flag:1|
     options-flag:0|
  -->Lib5E_SET_GLOBAL_MOD_STATUS|[*S:character_id];ac;[&ModName];1
  -->far_PlayEffects|[*S:t-id];;;burn-holy
  -->Finish|

 --:SetMod|
  -->Lib5E_SET_GLOBAL_MOD_STATUS|[*S:character_id];ac;[&ModName];1
  -->far_PlayEffects|[*S:t-id];;;burn-holy
  -->Finish|

 --:Remove|
  --#whisper|
  --#emotetext|[*S:character_name] no longer has [&SpellName]!
  -->ClearShieldEffects|
  --+|The invisible barrier vanishes! Your AC returns to normal.
  --X|

 --:Finish|
  -->GetCharID|[&CharName];ShieldID
  -->GetCharID|[&ReactCharName];ReactID
  -->SpawnShieldGraphics|
  --#whisper|
  --#emotetext|[*S:character_name] casts [&SpellName]!
  --+Duration: |[&duration]
  --?"X[$WildFeatFlag]" -eq "X1" -and [&MinimumSpellLevel] -ge 1|>far_WildTable
  --+|[br]
  --+Desc: |[&spelldesc]
  -->far_DeductSpellSlot|[*S:t-id];[$SpellLevel]
  --X|

 --:SpawnShieldGraphics|
  --~|array;define;ShieldGraphics
  --&ReactTID|
  --&ShieldTID|
  --?[&SpawnScript] -eq 2|[
   --@forselected+|Spawn _name|[&ReactCharName] _qty|1 _offset|0,0 _force|yes _size|3 _tokenProps|name:[&ReactTokenName],showname:false,showplayers_name:false _order|toBack _bar1|KeepLink _fx|nova-magic _expand|15,30 {^&select @{selected|token_id}} {&delay 1}
   -->far_FindPageTokenByName|[*S:t-id];[&ReactTokenName];ReactTID
   --?"X[&ReactTID]" -ne "X"|>AttachReactFx
   --@forselected+|Spawn _name|[&CharName] _qty|1 _offset|0,0 _force|yes _size|3 _tokenProps|name:[&TokenName],showname:false,showplayers_name:false _order|toBack _bar1|KeepLink _fx|nova-magic _expand|15,30 {^&select @{selected|token_id}} {&delay 1}
   -->far_FindPageTokenByName|[*S:t-id];[&TokenName];ShieldTID
   --?"X[&ShieldTID]" -ne "X"|>AttachShieldFx
   --~ShieldGraphicString|array;stringify;ShieldGraphics;!@!
   --!a:[*S:character_id]|!ShieldSpellGraphics:[&ShieldGraphicString]
   --<|
  --]|
  
  --!ot:ReactTID|name:"[&ReactTokenName]"|_pageid:[*S:t-_pageid]|left:[*S:t-left]|top:[*S:t-top]|width:[=[*S:t-width]*3]|height:[=[*S:t-height]*3]|imgsrc:"[&Reactlink]"|bar1_value:1|represents:[&ReactID]|showname:0
  --?"X[&ReactTID]" -eq "X"|[
   -->far_FindPageTokenByName|[*S:t-id];[&ReactTokenName];ReactTID
  --]|
  --?"X[&ReactTID]" -ne "X"|>AttachReactFx
  --!ot:ShieldTID|name:"[&TokenName]"|_pageid:[*S:t-_pageid]|left:[*S:t-left]|top:[*S:t-top]|width:[=[*S:t-width]*3]|height:[=[*S:t-height]*3]|imgsrc:"[&URLlink]"|bar1_value:1|represents:[&ShieldID]|showname:0
  --?"X[&ShieldTID]" -eq "X"|[
   -->far_FindPageTokenByName|[*S:t-id];[&TokenName];ShieldTID
  --]|
  --?"X[&ShieldTID]" -ne "X"|>AttachShieldFx
  --~ShieldGraphicString|array;stringify;ShieldGraphics;!@!
  --!a:[*S:character_id]|!ShieldSpellGraphics:[&ShieldGraphicString]

  --<|

 --:AttachReactFx|
  --?"X[&DebugCarry]" -eq "X1"|ShieldCarryDebug;react;[*S:t-id];[&ReactTID]
  --z:graphic:[&ReactTID]|toback
  --@CARRY_TOKENS_CARRY_BELOW|[*S:t-id] [&ReactTID]
  --~|array;add;ShieldGraphics;[&ReactTID]
  --<|

 --:AttachShieldFx|
  --?"X[&DebugCarry]" -eq "X1"|ShieldCarryDebug;shield;[*S:t-id];[&ShieldTID]
  --z:graphic:[&ShieldTID]|toback
  --@CARRY_TOKENS_CARRY_BELOW|[*S:t-id] [&ShieldTID]
  --~|array;add;ShieldGraphics;[&ShieldTID]
  --<|

 --:ShieldCarryDebug|label;carrier-id;fx-id
  --&DbgCarrierName|[*[%2%]:t-name]
  --#targettoken|[%3%]
  --&DbgFxName|[*T:t-name]
  --+|[b][%1%] carry[/b] — carrier [%2%] ([&DbgCarrierName]) → fx [%3%] ([&DbgFxName])
  --+Command|!CARRY_TOKENS_CARRY_BELOW [%2%] [%3%]
  --<|

  --/| ____________________ Procedures_______________________________________________________________________________________

 --:ClearShieldEffects|
  -->Lib5E_SET_GLOBAL_MOD_STATUS|[*S:character_id];ac;[&ModName];0
  --?"X[*S:ShieldSpellGraphics]" -ne "X"|[
   --~|array;fromstring;ShieldGraphics;!@!;[*S:ShieldSpellGraphics]
   --%gfx|foreach;ShieldGraphics
    --?"X[&gfx]" -ne "X"|[
      --~|object;token;delete;[&gfx]
      --]|
   --%|
  --]|[
   --&TokenName|[*S:character_name] [&SpellName]
   --&ReactTokenName|[*S:character_name] [&ReactCharName]
   --~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&TokenName]
   --%delShield|foreach;tokens
    --~|object;token;delete;[&delShield]
   --%|
   --~count|array;pagetokens;react;[*S:t-id];tprop:name=[&ReactTokenName]
   --%delReact|foreach;react
    --~|object;token;delete;[&delReact]
   --%|
  --]|
  --!a:[*S:character_id]|!ShieldSpellGraphics:**
  --<|

 --:GetCharID|CharacterName;StringVariableForCharID
  --~|array;objects:character;SpiritCharArr;[%1%]
  --?[@SpiritCharArr(length)] -ne 1|>far_FatalError;Could not find character named [%1%];ERROR;Create a journal character named [%1%] for Shield graphics
  --&[%2%]|[@SpiritCharArr(0)]
  --<|

}}