!script {{
  +++5Elib;snlib;Farsidelib+++
  
  --/|Script Name : Hold Person
  --/|Version     : 2.2.0
  --/|Modified By : Farsidegallery
  --/|  
  --/|  Script prompts user for spell level used and makes sure the slot is available.  and spawn the designated token to the VTT. Script calculates
  --/|  It will deduct 1 spell slot from the appropriate level
  --/|
  
  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________
  
  --&SpellName|Hold Person
  --&MinimumSpellLevel|2
  
  --&attrib|wisdom
  
  --/|Are you using the matching Bardic Inspiration Script from FarsideGallery? (Default is No using 0. Change to 1 if using the script.)
  --=Scriptcheck|1
     
  --/|Enter name for Hold Person Character.
  --&HoldName|Hold Person
  
  --/|Use ScriptCards (1) or SpawnDefaultToken (2) to place the Hold Person Character on the VTT?
  --&SpawnScript|1
  
  --&URLlink|https://files.d20.io/images/466854566/nKYG4ZHQRrXpOym7t_lidg/med.webm?1765082260
      
  --/| ____________________ End Global User Variables ___________________________________________________________________________________________
  
  --/|Helper variable build up to allow us to include a target prompt in an rbutton
  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[ 
  --&cbrac|]
  --&oparen|(
  --&cparen|)
  
  -->far_LoadTokenMarkers|
  
  --~shortattrib|string;left;3;[&attrib]
  --~Displayattrib|string;touppercase;[&shortattrib]
  
  --#title|[&SpellName]
  --#sourceToken|@{selected|token_id}
  --#reentrant|My Cool Script @{selected|character_id}
  --#whisper|self,gm
  --#emotetext|[*S:character_name] casts Hold Person!
  --&HoldTokenName|[*S:character_name] [&SpellName]
  -->GetSpiritID|[&HoldName];CharNameID
  
  -->ChooseLevel|
  --X|
  
  --:ChooseLevel|
   --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
   --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
   
   --+Choose Function: |[rbutton]New Cast::New[/rbutton][rbutton]Dismiss::Remove[/rbutton]
   --X|
  
  --:New|
   -->far_GetAvailableSpellLevels|[*S:character_id];[&MinimumSpellLevel];SpellCastLevel
   --?[@SpellCastLevel(length)] -eq 0|>far_FatalError;No Spell Slots Available;ERROR;No spell slots are available to cast [&SpellName]
   
   --+|[c][b]Cast At What Level?[/b][/c]
    --&splvlMsg|
    --%splvl|foreach;SpellCastLevel
     --&splvlMsg|+ [rbutton][&splvl]::SelectDiceRoll;[&splvl][/rbutton]
    --%|
   --+|[c][&splvlMsg][/c]
   --X|
  
  --:SelectDiceRoll|
   --=SpellLevel|[&reentryval]
   --&SpellLevel|[&reentryval]
   --#leftsub|[*R:spellrange]
   --#rightsub|WIS Save DC: [*S:spell_save_dc]
   --?[*R:spellconcentration] -inc 1|&duration;[*R:spellduration] [b](Concentration)[/b]|&duration;[*R:spellduration]
   --&desc|[*R:spelldescription]
   --&higherdesc|[*R:spellathigherlevels]
   --=DC|[*S:spell_save_dc]

   -->far_FIND_CLASS_LEVEL|[*S:character_id];Sorcerer;SLevel
   --?"X[&SLevel]" -eq "X0"|ChooseLevel
   -->far_FindFeat|[*S:character_id];"Wild Magic Surge";WildFeatFlag
   -->BuildArray|
   
  --:BuildArray|
   --=targets|[$SpellLevel]-1
   --=NumHeld|0
   -->far_BuildTargetList|[$targets.Total]
   -->far_BuildTargetArray|Held;[$targets.Raw];TargetString
   -->SaveLoop|
   
   --?"X[$WildFeatFlag]" -eq "X1" -and [&MinimumSpellLevel] -ge 1|>far_WildTable

   --?[*R:spellconcentration] -inc 1|&duration;[*R:spellduration] [b](Concentration)[/b]|&duration;[*R:spellduration]
   --+[br]|
   --+Duration: |[&duration]
   --+Desc: |[&desc]
   --+At Higher Levels: |[&higherdesc]
   -->far_DeductSpellSlot|[*S:t-id];[$SpellLevel]
   --?[$NumHeld] -gt 0 -and [&SpawnScript] -eq 2|[
    --@forselected+|Spawn _name|[&HoldName] _qty|1 _targets|[$NumHeld],Select the [$NumHeld] targets that failed the save. _offset|0,0 _force|yes _size|3 _tokenProps|name:[&HoldTokenName],showname:true,showplayers_name:true _order|toBack _bar1|KeepLink _fx|nova-magic _expand|15,30 {^&select @{selected|token_id}}
    --]|
   --X|

 --/| ____________________ Procedures_______________________________________________________________________________________
  
  --:SaveLoop|
   --#whisper|
   --?[$targets.Raw] -eq 1|[
	--~|array;removeat;Held;1
	--]|
   --+[br]|
   --+|[c]You targeted [$targets] creature(s).[/c]
   --+[br]|
   --%loop|foreach;Held
	--#targettoken|[&loop]
	--#emoteText|[*S:t-name] casts [&SpellName] at [*T:t-name]!
	-->ActionSpell|
   --:BottomForEachTarget|
   --%|
   -->Output|
   --<|
	
  --:ActionSpell|
   --?"[*T:npc]" -eq "1" -and "[*T:npc_type]" -ninc "humanoid"|[
	--&ResultLabel[*T:t-id]|[b]Invalid Target[/b]
	--&ResultText[*T:t-id]|[*T:t-name] is not a humanoid. Hold Person has no effect.
	--&SaveResult[*T:t-id]|Invalid
	--^BottomForEachTarget|
   --]|
   --?"[*T:npc_condition_immunities]" -inc "paralyzed" -or "[*T:npc_immunities]" -inc "paralyzed"|[
	--&ResultLabel[*T:t-id]|[b]Immune[/b]
	--&ResultText[*T:t-id]|[*T:t-name] is immune to being paralyzed.
	--&SaveResult[*T:t-id]|Immune
	--^BottomForEachTarget|
   --]|
   --?"[*T:npc]" -ne "1"|PCRoll|NPCRoll
   
  --:PCRoll|
   --&control|[*O:[*T:t-represents]:character:controlledby]
   --&playername|[*O:[&control]:player:displayname]
   --?"X[&playername]" -eq "X"|[
    --#whisper|gm
	--]|[
    --#whisper|[&playername],gm
	--]|
   -->ChooseRoll|PC
  
  --:NPCRoll|
   --#whisper|gm
   -->ChooseRoll|NPC
  
  --:ChooseRoll| 
   --&function|[%1%]
   --+|[c]Choose Saving Throw Type for [*T:t-name]:[/c]
   --+|[c][rbutton]Advantage::[&function];2d20kh1[/rbutton][rbutton]Normal::[&function];1d20[/rbutton][rbutton]Disadvantage::[&function];2d20kl1[/rbutton][/c]
   --X|
  
  --:NPC|
   --&saveDice[*T:t-id]|[&reentryval]
   --&Blessroll[*T:t-id]|
   --&Baneroll[*T:t-id]|
   --#whisper|
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BlessedMarker];BlessFlag[*T:t-id];BlessCount[*T:t-id]
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BaneMarker];BaneMarkerFlag[*T:t-id];BaneMarkerCount[*T:t-id]
   --?[&BlessFlag[*T:t-id]] -eq 1|&Blessroll[*T:t-id];+ + 1d4 [Bless] |&Blessroll[*T:t-id];
   --?[&BaneMarkerFlag[*T:t-id]] -eq 1|&Baneroll[*T:t-id];+ - 1d4 [Bane] |&Baneroll[*T:t-id];
   --?[*T:npc] -eq 1 -and [*T:npc_[&shortattrib]_save_flag] -gt 0|&Save;npc_[&shortattrib]_save |&Save;[&attrib]_mod
   --=InitSave[*T:t-id]|[&saveDice[*T:t-id]]
   --c[&saveDice[*T:t-id]]|2d20kh1:&DisplayDice[*T:t-id];Advantage|1d20:&DisplayDice[*T:t-id];1d20|2d20kl1:&DisplayDice[*T:t-id];Disadvantage
   --?[$InitSave[*T:t-id].Base] -eq 20|>Crit
   --=TargetSave[*T:t-id]|[$InitSave[*T:t-id]] + [*T:[&attrib]_save_bonus] [&obrac][&Displayattrib][&cbrac] [&Blessroll[*T:t-id]] [&Baneroll[*T:t-id]]
   --?[$TargetSave[*T:t-id]] -ge [$DC]|>Pass |>Fail   
   
  --:PC| 
   --&saveDice[*T:t-id]|[&reentryval]
   --&Blessroll[*T:t-id]|
   --&Baneroll[*T:t-id]|
   -->far_Check_GLOBAL_ATTRIB_SAVE_EXISTS|[*T:character_id]; [&attrib]; attribSaveRoll[*T:t-id]
   --?[&attribSaveRoll[*T:t-id]] -eq 1 -and "[&saveDice[*T:t-id]]" -eqi "1d20"|&saveDice[*T:t-id];2d20kh1
   --?[&attribSaveRoll[*T:t-id]] -eq 1 -and "[&saveDice[*T:t-id]]" -eqi "2d20kl1"|&saveDice[*T:t-id];1d20
   
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&InspirationMarker];InspiredFlag[*T:t-id];InspiredCount[*T:t-id]
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BardicMarker];BardicFlag[*T:t-id];BardicCount[*T:t-id]
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BlessedMarker];BlessFlag[*T:t-id];BlessCount[*T:t-id]
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BaneMarker];BaneMarkerFlag[*T:t-id];BaneMarkerCount[*T:t-id]
   
   --?[&InspiredFlag[*T:t-id]] -ne 0 |>far_Inspiration;[*T:t-id];[&InspirationMarker];[&saveDice[*T:t-id]];saveDice[*T:t-id]
   -->far_FIND_ACTIVE_GLOBAL_SAVE_MODS|[*T:character_id];GlobalSave[*T:t-id]
   -->far_FIND_ACTIVE_GLOBAL_SKILL_MODS|[*T:character_id];GlobalSkill[*T:t-id]
   
   --=InitSave[*T:t-id]|[&saveDice[*T:t-id]]
   --c[&saveDice[*T:t-id]]|2d20kh1:&DisplayDice[*T:t-id];Advantage|1d20:&DisplayDice[*T:t-id];1d20|2d20kl1:&DisplayDice[*T:t-id];Disadvantage
   --?[$InitSave[*T:t-id].Base] -eq 20|>Crit
   
   --=attribSaveRoll[*T:t-id]|[$InitSave[*T:t-id]] + [*T:[&attrib]_save_bonus] [&Displayattrib]
   --?[&BardicFlag[*T:t-id]] -eq 1|>far_Bardic;[*T:t-id];[&BardicMarker];[$Scriptcheck];[$InitSave[*T:t-id].Base];[$attribSaveRoll[*T:t-id]];BardRoll[*T:t-id]
   --?[&BlessFlag[*T:t-id]] -eq 1|&Blessroll[*T:t-id];+ + 1d4 [Bless] |&Blessroll[*T:t-id];
   --?[&BaneMarkerFlag[*T:t-id]] -eq 1|&Baneroll[*T:t-id];+ - 1d4 [Bane] |&Baneroll[*T:t-id];
   
   --=TargetSave[*T:t-id]|[$InitSave[*T:t-id]] + [*T:[&attrib]_save_bonus] [&obrac][&Displayattrib][&cbrac] [&GlobalSave[*T:t-id]] [&GlobalSkill[*T:t-id]] [&Blessroll[*T:t-id]] [&Baneroll[*T:t-id]] [&BardRoll[*T:t-id]]

   --#whisper|
   --?[$TargetSave[*T:t-id]] -ge [$DC]|>Pass |>Fail
   
  --:Crit|
   --&ResultLabel[*T:t-id]|[b]Critical Save![/b]
   --&ResultText[*T:t-id]|[*T:t-name] rolled a [$InitSave[*T:t-id]] vs a DC [$DC] and cannot fail the saving throw.
   --&SaveResult[*T:t-id]|Pass
   --^BottomForEachTarget|
  
  --:Pass|
   --&ResultLabel[*T:t-id]|[b]Pass[/b]
   --&ResultText[*T:t-id]|[*T:t-name] rolled a [$TargetSave[*T:t-id]] vs a DC [$DC] and passed the saving throw.
   --&SaveResult[*T:t-id]|Pass
   --^BottomForEachTarget|

  --:Fail|
   --&ResultLabel[*T:t-id]|[b]Failed[/b]
   --&ResultText[*T:t-id]|[*T:t-name] rolled a [$TargetSave[*T:t-id]] vs a DC [$DC] and failed the saving throw.
   --&SaveResult[*T:t-id]|Fail
   --^BottomForEachTarget|

  --:Output|
   --#whisper|
   --%loop|foreach;Held
    --#targettoken|[&loop]
    --+|[c][b]Target: [*T:t-name][/b][/c]
    --?"[&SaveResult[*T:t-id]]" -ne "Immune" -and "[&SaveResult[*T:t-id]]" -ne "Invalid"|[
     --+Rolling [&DisplayDice[*T:t-id]]: |[$InitSave[*T:t-id]]
     --+|[br]
    --]|
    --+[&ResultLabel[*T:t-id]]: |[&ResultText[*T:t-id]]
    --?"[&SaveResult[*T:t-id]]" -eq "Fail"|[
     -->LibSN_ADD_STATUS_MARKER|[*T:t-id];[&HoldMarker]
     --?[&SpawnScript] -eq 1|[
      --!ot:HoldTID|name:"[&HoldTokenName]"|left:[*T:t-left]|top:[*T:t-top]|width:[=[*T:t-width]*3]|height:[=[*T:t-height]*3]|imgsrc:"[&URLlink]"|bar1_value:1|represents:[&CharNameID]|showname:false
      --z:graphic:[&HoldTID]|toback
      --@CARRY_TOKENS_CARRY_BELOW|[*T:t-id] [&HoldTID]
     --]|
     --=NumHeld|[$NumHeld]+1
     --!a:[*S:character_id]|!ConcentrationSpell:[&SpellName]
     --!a:[*S:character_id]|!ConcentrationSpellTargetToken:[&HoldTokenName]
     --!a:[*T:character_id]|!MageID:[*S:character_id]
     -->LibSN_ADD_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];10
    --]|
    --+|[br]
   --%|
   --<|
  
  --:GetSpiritID|CharacterName;StringVariableForCharID
   --~|array;objects:character;SpiritCharArr;[%1%]
   --?[@SpiritCharArr(length)] -ne 1|>far_LogFatalError;Could not find character named [%1%]
   --&[%2%]|[@SpiritCharArr(0)]
   --<|
  
  --:Remove|
   --#emotetext|[*S:character_name] dismisses Hold Person!
   --#whisper|
   -->LibSN_REMOVE_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker]
   --~|array;pagetokens;alltokens;[*S:t-id]
   --~|array;define;Held
   --%loop|foreach;alltokens
    -->LibSN_CHECK_STATUS_MARKER|[*[&loop]:t-id];[&HoldMarker];HoldFlag;HoldCount
    --?[&HoldFlag] -eq 1 -and "[*[&loop]:MageID]" -inc "[*S:character_id]"|[
    --&Held([@Held(length)])|[*[&loop]:t-id]
    --]|
    --%|
 
   --%loop|foreach;Held
    -->LibSN_REMOVE_STATUS_MARKER|[*[&loop]:t-id];[&HoldMarker]
	--!a:[*[&loop]:character_id]|MageID:**
    --+|[*[&loop]:character_name] is no longer Held.
    --%|
   
   --~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&HoldTokenName]
   --%loop|foreach;tokens
	--~|object;token;delete;[*[&loop]:t-id]
	--%| 
  --X|  
}}