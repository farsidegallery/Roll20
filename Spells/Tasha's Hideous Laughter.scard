!script {{
  +++5Elib;snlib;Farsidelib+++	
  
  --#sourceToken|@{selected|token_id}
  --#reentrant|My Cool Script @{selected|character_id}
  
  --/|Script Name : Tasha's Hideous Laughter
  --/|Version     : 1.1.0
  --/|Requires SC : ScriptCards Library 5Elib/snlib/Farsidelib
  --/|Author      : Farsidegallery
  --/|  
  --/|  Script prompts user to target a creature and resolve a Wisdom saving throw (with save modifiers). On a failed save the target is marked incapacitated and prone,
  --/|  and concentration is tracked until dismissed. Undead, constructs, and creatures with Intelligence 4 or less consume a slot with no effect, appearing as a successful save.
  --/|  It will deduct 1 spell slot from the appropriate level.
  --/|  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________
    
   --&SpellName|Tasha's Hideous Laughter
   --&MinimumSpellLevel|1
   
   --&attrib|wisdom
   
   --/|Are you using the matching Bardic Inspiration Script from FarsideGallery? (Default is No using 0. Change to 1 if using the script.)
   --=Scriptcheck|1
   
  --/| ____________________ End Global User Variables ___________________________________________________________________________________________
  
  --/|Helper variable build up to allow us to include a target prompt in an rbutton
  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[ 
  --&cbrac|]
  --&oparen|(
  --&cparen|)
  
  -->far_LoadTokenMarkers|

  --~shortattrib|string;left;3;[&attrib]
  --~Displayattrib|string;touppercase;[&shortattrib]
  
  --=DC|[*S:spell_save_dc]
  
  --#title|[&SpellName]
  --#leftsub|Spell Level [&MinimumSpellLevel]
  --#rightsub|[&Displayattrib] Save DC:[$DC]
  
  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
  
  --#leftsub|[*R:spellcastingtime]
  --#rightsub|[*R:spellrange]
  --?[*R:spellconcentration] -inc 1|&duration;[*R:spellduration] [b](Concentration)[/b]|&duration;[*R:spellduration]
  --&desc|[*R:spelldescription]
  
  --:ChooseFunction|
   --+Choose Function: |[rbutton]New Cast::NewCast;&#64;{target|token_id}[/rbutton][rbutton]Dismiss::Remove[/rbutton]
   --X|

  --:NewCast|
   -->far_GetAvailableSpellLevels|[*S:character_id];[&MinimumSpellLevel];SpellCastLevel
   --?[@SpellCastLevel(length)] -eq 0|>far_FatalError;No Spell Slots Available;ERROR;No spell slots are available to cast [&SpellName]
   -->far_GetAndCheckSlotInformation|[*S:t-id];[&MinimumSpellLevel]
   
   --#targetToken|[&reentryval]
   --?"[*T:npc_type]" -inc "undead"|InvalidEnd
   --?"[*T:npc_type]" -inc "construct"|InvalidEnd
   --?"X[*T:intelligence]" -ne "X" -and [*T:intelligence] -le 4|InvalidEnd
   --?"X[*T:npc_int]" -ne "X" -and [*T:npc_int] -le 4|InvalidEnd
   --#emotetext|[*S:t-name] casts [&SpellName] on [*T:t-name]!
   --?"[*T:npc]" -ne "1"|PCRoll |NPCRoll
   
  --:PCRoll|
   --&control|[*O:[*T:t-represents]:character:controlledby]
   --&playername|[*O:[&control]:player:displayname]
   --?"X[&playername]" -eq "X"|[
    --#whisper|gm
	--]|[
    --#whisper|[&playername],gm
	--]|
   -->ChooseRoll|PC
  
  --:NPCRoll|
   --#whisper|gm
   -->ChooseRoll|NPC
  
  --:ChooseRoll| 
   --&function|[%1%]
   --+|[c]Choose Saving Throw Type:[/c]
   --+|[c][rbutton]Advantage::[&function];2d20kh1[/rbutton][rbutton]Normal::[&function];1d20[/rbutton][rbutton]Disadvantage::[&function];2d20kl1[/rbutton][/c]
   --X|
  
  --:NPC|
   --&saveDice|[&reentryval]
   --&Blessroll|
   --&Baneroll|
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BlessedMarker];BlessFlag;BlessCount
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BaneMarker];BaneMarkerFlag;BaneMarkerCount
   --?[&BlessFlag] -eq 1|&Blessroll;+ + 1d4 [Bless] |&Blessroll;
   --?[&BaneMarkerFlag] -eq 1|&Baneroll;+ - 1d4 [Bane] |&Baneroll;
   --?[*T:npc] -eq 1 -and [*T:npc_[&shortattrib]_save_flag] -gt 0|&Save;npc_[&shortattrib]_save |&Save;[&attrib]_mod
   --=Save|[&saveDice] + [*T:[&Save]] [&Displayattrib] [&Blessroll] [&Baneroll]
   --?[$Save.Base] -eq 20|>Crit
   --?[$Save] -ge [$DC]|>Pass |>Fail   
   
  --:PC| 
   --&saveDice|[&reentryval]
   --&Blessroll|
   --&Baneroll|
   -->far_Check_GLOBAL_ATTRIB_SAVE_EXISTS|[*T:character_id]; [&attrib]; attribSaveRoll
   --?[&damageSave] -eq 1 -or [&attribSaveRoll] -eq 1|[
    --?"[&saveDice]" -eqi "1d20"|&saveDice;2d20kh1
    --?"[&saveDice]" -eqi "2d20kl1"|&saveDice;1d20
   --]|   
  
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&InspirationMarker];InspiredFlag;InspiredCount
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BardicMarker];BardicFlag;BardicCount
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BlessedMarker];BlessFlag;BlessCount
   -->LibSN_CHECK_STATUS_MARKER|[*T:t-id];[&BaneMarker];BaneMarkerFlag;BaneMarkerCount
   
   --?[&InspiredFlag] -ne 0 |>far_Inspiration;[*T:t-id];[&InspirationMarker];[&saveDice];saveDice
   -->far_FIND_ACTIVE_GLOBAL_SAVE_MODS|[*T:character_id];GlobalSave
   -->far_FIND_ACTIVE_GLOBAL_SKILL_MODS|[*T:character_id];GlobalSkill
   
   --=InitSave|[&saveDice]
   --c[&saveDice]|2d20kh1:&DisplayDice;Advantage|1d20:&DisplayDice;1d20|2d20kl1:&DisplayDice;Disadvantage
   --+Rolling [&DisplayDice]: |[$InitSave]
   --+|[br]
   --?[$InitSave.Base] -eq 20|>Crit
   
   --=attribSaveRoll|[$InitSave] + [*T:[&attrib]_save_bonus] [&Displayattrib]
   --?[&BardicFlag] -eq 1|>far_Bardic;[*T:t-id];[&BardicMarker];[$Scriptcheck];[$InitSave.Base];[$attribSaveRoll];BardRoll
   --?[&BlessFlag] -eq 1|&Blessroll;+ + 1d4 [Bless] |&Blessroll;
   --?[&BaneMarkerFlag] -eq 1|&Baneroll;+ - 1d4 [Bane] |&Baneroll;
   
   --=Save|[$InitSave] + [*T:[&attrib]_save_bonus] [&obrac][&Displayattrib][&cbrac] [&GlobalSave] [&GlobalSkill] [&Blessroll] [&Baneroll] [&BardRoll]

   --#whisper|
   --?[$Save] -ge [$DC]|>Pass |>Fail
  
  --:Crit|
   --?"X[$InitSave.Base]" -ne "X"|&CritDie;[$InitSave.Base]|&CritDie;[$Save.Base]
   --+Save: |[*T:t-name] rolled a [&CritDie] vs a DC [$DC] and cannot fail the saving throw. 
   -->Output|
  
  --:Pass|
   --+Save: |[*T:t-name] rolled a [$Save] vs a DC [$DC] and passed the saving throw. 
   -->Output|
   
  --:Fail|
   --+Save: |[*T:t-name] rolled a [$Save] vs a DC [$DC] and failed the saving throw. 
   --+|[br]
   --+Result: |[*T:t-name] perceives everything as hilariously funny and falls prone in fits of laughter.
   -->LibSN_ADD_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];10
   -->LibSN_ADD_STATUS_MARKER|[*T:t-id];[&IncapacitatedMarker];1
   -->LibSN_ADD_STATUS_MARKER|[*T:t-id];[&ProneMarker];1
   --!a:[*S:character_id]|!ConcentrationSpell:[&SpellName]
   --!a:[*S:character_id]|!ConcentrationSpellTargetToken:[*T:t-id]
   -->Output|
   
  --:Output|
   --#whisper|
   
   -->far_PlayEffects|[*S:t-id];[*T:t-id];;burst-magic

   --+|[br]
   --+Duration: |[&duration]
   --+Desc: |[&desc]
   -->far_DeductSpellSlot|[*S:t-id];[&MinimumSpellLevel]
   --X|
  
  --:InvalidEnd|
   --#whisper|
   --#emotetext|[*S:t-name] casts [&SpellName] on [*T:t-name]!
   --?"[*T:npc]" -ne "1"|[
    --=Save|1d20 + [*T:wisdom_save_bonus] [WIS]
   --]|[
    --?[*T:npc] -eq 1 -and [*T:npc_wis_save_flag] -gt 0|&SaveAttr;npc_wis_save |&SaveAttr;wisdom_mod
    --=Save|1d20 + [*T:[&SaveAttr]] [&Displayattrib]
   --]|
   --?[$Save] -lt [$DC]|=Save|[$DC]
   --+Save: |[*T:t-name] rolled a [$Save] vs a DC [$DC] and passed the saving throw.
   -->far_PlayEffects|[*S:t-id];[*T:t-id];;burst-magic
   --+|[br]
   --+Duration: |[&duration]
   --+Desc: |[&desc]
   -->far_DeductSpellSlot|[*S:t-id];[&MinimumSpellLevel]
   --X|
  
  --:Remove|
   --#whisper|
   --?"X[*S:ConcentrationSpell]" -eq "X" -or "[*S:ConcentrationSpell]" -ne "[&SpellName]"|[
    --+|[*S:character_name] is not concentrating on [&SpellName].
    --X|
   --]|
   --#targetToken|[*S:ConcentrationSpellTargetToken]
   --+|[*S:character_name] is no longer concentrating.
   --+|[br]
   --+|[*T:t-name] is no longer laughing uncontrollably.
   -->LibSN_REMOVE_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker]
   -->LibSN_REMOVE_STATUS_MARKER|[*T:t-id];[&IncapacitatedMarker]
   -->LibSN_REMOVE_STATUS_MARKER|[*T:t-id];[&ProneMarker]
   --!a:[*S:character_id]|!ConcentrationSpell:**
   --!a:[*S:character_id]|!ConcentrationSpellTargetToken:**
   --X|
}}