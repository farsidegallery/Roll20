!script{{
  +++snlib;Farsidelib+++	
 
  --#sourceToken|@{selected|token_id}
  --#reentrant|Summon Celestial @{selected|character_id}
  --#whisper|self,gm

  --/|Script Name : Summon Celestial
  --/|Version     : 2.0.0
  --/|Requires SC : Token Action Maker, ScriptCards Library snlib/Farsidelib
  --/|Author      : Farsidegallery
  --/|  
  --/|  Script prompts for celestial form (Avenger or Defender), then spell level, deducts a slot, updates the spirit NPC sheet, and places a token via ScriptCards object-token API.
  --/|  Pre-stage artwork URLs below (AvengerURL / DefenderURL).
  --/|
 
  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________
    
  --/|Enter name for Celestial Spirit Character.
  --&SpiritName|[*S:character_name] Celestial Spirit
  
  --&SpellName|Summon Celestial
  --&MinimumSpellLevel|5

  --&VFX|nova-magic

  --/| Celestial spirit token art (user-uploaded images; one face per form)
  --&AvengerURL|https://files.d20.io/images/503414854/U8y1mulllegS4IDFIPMfkw/original.webp
  --&DefenderURL|https://files.d20.io/images/403083495/bLmfcvdgua9vo87sZ5x03Q/original.png?1722399498

  --/| Spell placement token (move on map, then target to confirm summon location)
  --&SpellTargetToken|Spell Token
  --&PlaceURLlink|https://files.d20.io/images/469753332/ew1SU1DcQK4eborJlOqNQw/original.png
  
  --/| ____________________ End Global User Variables ___________________________________________________________________________________________
  
  --/|Helper variable build up to allow us to include a target prompt in an rbutton
  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[ 
  --&cbrac|]
  --&oparen|(
  --&cparen|)
   
  -->far_LoadTokenMarkers|

  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
   --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
  
  -->GetSpiritID|[&SpiritName];SpiritID
  --&control|[*O:[*S:t-represents]:character:controlledby]
  --#title|[&SpellName]
  -->ChooseShape|
  --X|  
  
  --:ChooseShape|
   --+|[c][b]Choose Form:[/b][/c]
   --+|[c][rbutton]Avenger::Summon;Avenger[/rbutton][rbutton]Defender::Summon;Defender[/rbutton][/c]
   --+|[br]
   --+|[c][rbutton]Dismiss::Remove[/rbutton][/c]
   --X|
   
  --:Summon|
   --&Shape|[&reentryval]
   --^ChooseLevel|

  --:ChooseLevel|
   -->far_GetAvailableSpellLevels|[*S:character_id];[&MinimumSpellLevel];SpellCastLevel
   --?[@SpellCastLevel(length)] -eq 0|>far_FatalError;No Spell Slots Available;ERROR;No spell slots are available to cast [&SpellName]
   --#rightsub|[&Shape] Celestial
   --+|[c][b]Cast At What Level?[/b][/c]
    --&splvlMsg|
    --%splvl|foreach;SpellCastLevel
     --&splvlMsg|+ [rbutton][&splvl]::PickLevel;[&splvl][/rbutton]
    --%|
   --+|[c][&splvlMsg][/c]
   --X|

  --:PickLevel|
   --=SpellLevel|[&reentryval]
   --&SpellLevel|[&reentryval]
   --#leftsub|[*R:spellcastingtime]
   --#rightsub|[&Shape] Celestial | [*R:spellrange]
   --?[*R:spellconcentration] -inc 1|&duration;[*R:spellduration] [b](Concentration)[/b]|&duration;[*R:spellduration]
   --&spelldesc|[*R:spelldescription]
   --&spellhigherdesc|[*R:spellathigherlevels]
   -->far_GetAndCheckSlotInformation|[*S:t-id];[$SpellLevel]
   --^SummonPlacement|

  --:SummonPlacement|
   --#whisper|self,gm
   --~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&SpellTargetToken]
   --?[@tokens(length)] -gt 0|[
    --~|object;token;delete;[@tokens(0)]
   --]|
   --+|Move the [&SpellTargetToken] to where the [&Shape] celestial should appear, then target it below.
   --!ot:NewTID|name:"[&SpellTargetToken]"|_pageid:[*S:t-_pageid]|left:[=[*S:t-left]+70]|top:[*S:t-top]|width:[*S:t-width]|height:[*S:t-height]|imgsrc:"[&PlaceURLlink]"|bar1_value:1|represents:"[&SpellTargetToken]"|showname:0
   --z:graphic:[&NewTID]|tofront
   --+Target: |[rbutton]Target the Spell Token.::SetSummonTarget;[&TB]target|token_id}[/rbutton]
   --X|

  --:SetSummonTarget|
   --#whisper|self,gm
   --#targettoken|[&reentryval]
   --?"[*T:t-name]" -ne "[&SpellTargetToken]"|[
    --+|[c]Please target the [&SpellTargetToken], not [*T:t-name].[/c]
    --X|
   --]|
   --^CompleteSummon|

  --:CompleteSummon|
   --#whisper|
   --#rightsub|[&Shape] Celestial
   --#emoteText|[*S:character_name] summons a [&Shape] Celestial!
   -->DetermineStats|
   --+Duration: |[&duration]
   --+Desc: |[&spelldesc]
   --+At Higher Levels: |[&spellhigherdesc]
   --+|[br]
   -->far_DeductSpellSlot|[*S:t-id];[$SpellLevel]
   --!a:[*S:character_id]|!ConcentrationSpell:[&SpiritName]
   -->LibSN_ADD_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];
   --!c:[&SpiritID]|controlledby:[&control]
   -->PlaceSpiritToken|
   --~|object;token;delete;[*T:t-id]
   --X|

  --:PlaceSpiritToken|
   --!ot:SpiritTID|name:"[&SpiritName]"|_pageid:[*T:t-_pageid]|left:[*T:t-left]|top:[*T:t-top]|width:[=[*S:t-width]*2]|height:[=[*S:t-height]*2]|imgsrc:"[&URLlink]"|represents:[&SpiritID]|bar1_value:[$HP]|bar1_max:[$HP]|bar2_value:[$AC]|showname:true|showplayers_name:true
   -->far_PlayEffects|[&SpiritTID];;[&VFX];;;
   --z:graphic:[&SpiritTID]|tofront
   --<|

  --:Remove|
   --?"[*S:ConcentrationSpell]" -eq "[&SpiritName]"|[
    --!a:[*S:character_id]|!ConcentrationSpell:**
   --]|
   --~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&SpiritName]
   --?[@tokens(length)] -gt 0|[
    --~|object;token;delete;[@tokens(0)]
   --]|
   -->LibSN_REMOVE_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker]
   --#whisper|
   --#emoteText|[*S:character_name] dismisses the [&SpellName] spirit!
   --+|[*S:character_name]'s celestial spirit vanishes.
   --X|
  
  --:GetSpiritID|CharacterName;StringVariableForCharID
   --~|array;objects:character;SpiritCharArr;[%1%]
   --?[@SpiritCharArr(length)] -ne 1|>far_LogFatalError;Could not find character named [%1%]
   --&[%2%]|[@SpiritCharArr(0)]
   --<|
  
  --:DetermineStats|
   --?[&Shape] -eq Avenger|&URLlink;[&AvengerURL]
   --?[&Shape] -eq Defender|&URLlink;[&DefenderURL]
   --=HPMod|[&SpellLevel]-5
   --=HPMod|[$HPMod]*10
   --=HP|40+[$HPMod] 
   --=AC|11+[&SpellLevel]
   --=PB|[*S:pb]
   --=action|1
   --c[&Shape]|Avenger:=action;1|Defender:=action;2
   --c[&Shape]|Avenger:&damage;2d6+2+[&SpellLevel]|Defender:&damage;1d10+3+[&SpellLevel]
   --c[&Shape]|Avenger:&description; |Defender:&description;The celestial can choose itself or another creature it can see within 10 feet of the target. The chosen creature gains 1d10 temporary hit points.
   --=attacks|[&SpellLevel]\2
   -->SetStats|[$action];[&damage];[&description]
   --<|
   
  --:SetStats|
   --/|Set HP
   --!a:[&SpiritID]|hp:[$HP]
   --!a:[&SpiritID]|hp^:[$HP]
   
   --/|Set AC and Prof Bonus
   --!a:[&SpiritID]|npc_ac:[$AC]
   --!a:[&SpiritID]|npc_pb:[$PB]
   
   --/|Set Actions information
   --rbyindex|[&SpiritID];repeating_npcaction;0
   --!a:[&SpiritID]|![*R>description]:The spirit makes [$attacks] attack(s).
   
   --rbyindex|[&SpiritID];repeating_npcaction;3
   --!a:[&SpiritID]|![*R>description]:The celestial touches another creature. The target magically regains hit points equal to 2d8 + [&SpellLevel].
   
   --rbyindex|[&SpiritID];repeating_npcaction;[%1%]
   --!a:[&SpiritID]|![*R>attack_tohit]:[*S:spell_attack_bonus]
   --!a:[&SpiritID]|![*R>attack_damage]:[%2%]
   --!a:[&SpiritID]|![*R>description]:[%3%]
   -->SetTokenActions|
   --<|
   
  --:SetTokenActions|
   --~|array;objects:ability;AbilityArr;;[&SpiritID]
   --?[&Shape] -eqi Avenger|[
    --!ability:[@AbilityArr(0)]|istokenaction:True
	 --!ability:[@AbilityArr(1)]|istokenaction:True
	 --!ability:[@AbilityArr(2)]|istokenaction:True
	 --!ability:[@AbilityArr(3)]|istokenaction:False
	 --!ability:[@AbilityArr(4)]|istokenaction:True
	 --!ability:[@AbilityArr(5)]|istokenaction:False
	 --!ability:[@AbilityArr(6)]|istokenaction:True
	 --]|
   --?[&Shape] -eqi Defender|[
    --!ability:[@AbilityArr(0)]|istokenaction:True
	 --!ability:[@AbilityArr(1)]|istokenaction:True
 	 --!ability:[@AbilityArr(2)]|istokenaction:True
	 --!ability:[@AbilityArr(3)]|istokenaction:False
	 --!ability:[@AbilityArr(4)]|istokenaction:False
	 --!ability:[@AbilityArr(5)]|istokenaction:True
	 --!ability:[@AbilityArr(6)]|istokenaction:True
	 --]|
   --<|
}}