!script {{
  +++5Elib;snlib;Farsidelib+++
  --#sourceToken|@{selected|token_id}
  --#reentrant|My Cool Script @{selected|character_id}
  --#whisper|self,gm
  --/|=========================================================================================================
  --/|Script Name : 5E Magic Missile
  --/|Version     : 3.2.0
  --/|Requires SC : TokenMod, Chatsetattr, ScriptCards Library snlib,Farsidelib
  --/|Author      : Kurt Jaegers
  --/|Modification: Farsidegallery
  --/|Description : Handles the D&D 5E spell Magic Missile, with the ability to select a dynamic
  --/|              number of targets. 
  --/|
  --/|              You can optionally have damage applied to impacted tokens. The script defaults to using
  --/|              TokenMod to update Bar 3. These can be changed by altering the settings below.
  --/|              If you use one die roll for Magic Missile, update the damageMode variable below.
  --/|=========================================================================================================
  --&SpellName|Magic Missile
  --&MinimumSpellLevel|1
  --&damageType|force
  --&hpBar|1
  --&tempHPbar|4
  --/|What resource name is used for Sorcerer Points?
  --&SorcererResource|Sorcery Points
  --/|Set this variable to the (case sensitive) name of a Jukebox track to play when the spell is cast
  --&SoundEffectTrack|
  --/|If damageMode is 1, a separate die will be rolled for each missile. Set this variable to 0 to, 
  --/|only have a single damage die roll applied to each missile.
  --&damageMode|1
  --/|What is the name of the Global AC Mod used for Shield.
  --&ModName|Shield Spell
  --&ShieldMarkAttr|mm_shield_active
  --/|Enter name for Shield Character.
  --&CharName|Shield Spell
  --/|Enter name for Reaction Used Character (journal NPC for spawn).
  --&ReactCharName|Reaction Used
  --&URLlink|https://files.d20.io/images/466430946/7DPjXj0n0IMCLlbLg50mPg/med.webm?1764787074
  --&link1|https://files.d20.io/images/476457994/FdbUAgAk_G-
  --&link2|-2d1MaQ9g4w/med.webm?1771472165
  --&Reactlink|[&link1][&link2]
  --/|Are you using the matching Bardic Inspiration Script from FarsideGallery? (Default is No using 0. Change to 1 if using the script.)
  --=Scriptcheck|1
  --/| ____________________ End Global User Variables ___________________________________________________________________________________________
  --/|Helper variable build up to allow us to include a target prompt in an rbutton
  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[ 
  --&cbrac|]
  --&oparen|(
  --&cparen|)
  
  -->far_LoadTokenMarkers|
  
  --#title|[&SpellName]
  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
  -->far_GetAvailableSpellLevels|[*S:character_id];[&MinimumSpellLevel];SpellCastLevel
  --?[@SpellCastLevel(length)] -eq 0|>far_FatalError;No Spell Slots Available;ERROR;No spell slots are available to cast [&SpellName]
  
  --#leftsub|[*R:spellcastingtime]
  --#rightsub|[*R:spellrange]
  --&desc|[*R:spelldescription]
  --&higher|[*R:spellathigherlevels]
  
  -->far_FIND_CLASS_LEVEL|[*S:character_id];Sorcerer;SLevel
  --?"X[&SLevel]" -eq "X0"|ChooseLevel
  -->far_FindFeat|[*S:character_id];"Metamagic: Empowered Spell";EmpowerFeatFlag
  -->far_FindFeat|[*S:character_id];"Wild Magic Surge";WildFeatFlag
  --=EmpowerDice|[*S:charisma_mod]
  --=SorceryPoints|0
  --=ChangeCount|0
  -->Lib5E_FIND_RESOURCE|[*S:character_id];[&SorcererResource];Pointsname;PointsAmmo
  --?"X[$PointsAmmo]" -le "X0" -or "[&Pointsname]" -eq "Not Found" -or [$PointsAmmo] -lt [$SorceryPoints]|ChooseLevel
  
  --:ChooseLevel|
  --+|[c][b]Cast At What Level?[/b][/c]
    --&splvlMsg|
    --%splvl|foreach;SpellCastLevel
     --&splvlMsg|+ [rbutton][&splvl]::ChooseType;[&splvl][/rbutton]
    --%|
  --+|[c][&splvlMsg][/c]
  --X|
  
  --:ChooseType|
   --=SpellLevel|[&reentryval]
   --&SpellLevel|[&reentryval]
   --=MissileCount|[$SpellLevel] + 2
   -->far_GetAndCheckSlotInformation|[*S:t-id];[$SpellLevel]
   -->far_BuildTargetList|[$MissileCount.Total]
   -->far_BuildTargetArray|Targets;[$MissileCount];TargetString;1
   -->BuildUnique|
   --&ShieldedList|;|
   --%loop|foreach;Targets
    -->MMShieldModExists|[*[&loop]:t-id];Exists
    --?[&Exists] -eq 1|>ShieldPrompt
    --Rfind|[*[&loop]:character_id];Shield;repeating_spell-1;spellname
    --?"X[*R:spellname]" -ne "XNoRepeatingAttributeLoaded"|>ShieldPrompt
    --:ShieldReturn|
    --%|
   --?"X[&damageMode]" -eq "X0"|>MissileSameDamage
   --=TargetCount|1
   --=TotalDamage|0
   --#emoteText|[*S:t-name] uses a level [$SpellLevel.Total] spell slot to fire [$MissileCount.Total] missiles of magical force!
   --?"X[&SoundEffectTrack]" -ne "X"|[
    --a|[&SoundEffectTrack]
    --]|
  
  --:MissileLoop|
   --#whisper|
   --%loop|foreach;Targets
    -->FireMissile|[&loop]
    --=TargetCount|[$TargetCount]+1
	  --%|
   --?"X[&damageMode]" -eq "X1"|[
    -->FinalizeDartResults|
    --%i|1;[$MissileCount];1
     --&ThisDartTarget|[&DartTarget[&i]]
     --+[&ResultLabel[&i]]: |[&ResultText[&i]]
     -->far_PlayEffects|[*S:t-id];[&ThisDartTarget];none;burst-smoke;beam-magic
     --%|
    --]|
   --+|Total damage is [$TotalDamage]
   --%loopTarget|foreach;Unique
    -->IsTargetShielded|[&loopTarget];ShieldHit
    --?[&ShieldHit] -eq 1|ApplySkipDamage
    -->far_DamageTokenmod|[&loopTarget];[&hpBar];[&tempHPbar];-[$Damage[&loopTarget]];0;0;1
	  --/|>LibSN_APPLY_DAMAGE_OR_HEALING|[&loopTarget];[&hitPointsBar];-[$Damage[&loopTarget]];0;0;1
    --:ApplySkipDamage|
	  --%|

   --#whisper|
   --+|[br]
   --?"X[$WildFeatFlag]" -eq "X1" -and [&MinimumSpellLevel] -ge 1|>far_WildTable
   --+Desc: |[&desc]
   --+At Higher Levels: |[&higher]
   --+|[br]
 
   -->far_DeductSpellSlot|[*S:t-id];[$SpellLevel]
 
   --?"X[$EmpoweredDamageFlag]" -eq "X1"|[
    --=FinalPointsAmmo|[$PointsAmmo]-[$SorceryPoints]
    --!a:[*S:character_id]|[&PointsAmmo]:[$FinalPointsAmmo]
    --+|[br]
	  --+[&SorcererResource]: |Used: [$SorceryPoints] / Remaining: [$FinalPointsAmmo]
    --]|
 
   -->ClearMMShieldMarks|
   --X|
 
  --:FireMissile|
   --&ThisTarget|[%1%]
   --#targettoken|[&ThisTarget]
   -->IsTargetShielded|[&ThisTarget];ShieldHit
   --?[&ShieldHit] -eq 1|>ShieldMitigation
   --&Hex|
   --&HexBlade|
   -->LibSN_CHECK_STATUS_MARKER|[*[&ThisTarget]:t-id];[&HexMarker];HexMarkerFlag;HexMarkerCount
   -->LibSN_CHECK_STATUS_MARKER|[*[&ThisTarget]:t-id];[&HexBladeMarker];HexBladeMarkerFlag;HexBladeMarkerCount
   --?"X[&HexMarkerFlag]" -eq "X1" -and "X[*S:ConcentrationSpellTargetToken]" -eqi "X[*[&ThisTarget]:t-id]"|&Hex; + 1d6 [Hex] |&Hex;
   --?"X[&HexBladeMarkerFlag]" -eq "X1" -and "X[*[&ThisTarget]:CurseCaster]" -eq "X[*S:t-id]"|&HexBlade; + [*S:pb] [Hexblade Curse] |&HexBlade;
   --&damageMod|
   --?"X[&damageMode]" -eq "X0"|[
    --=ThisMissile|[$OneMissileDamage]
    -->far_PlayEffects|[*S:t-id];[&ThisTarget];none;burst-smoke;beam-magic
    --]|
   
   --?"X[&damageMode]" -eq "X1"|[
    --=ThisMissile|1d4+1
    --?"X[$EmpowerFeatFlag]" -eq "X1"|>far_EmpowerSelect;ThisMissile;Hit;DamageChangedFlag[&ThisTarget];ChangedDamage[&ThisTarget]
    --?"X[$DamageChangedFlag[&ThisTarget]]" -eq "X1"|[
     --=ThisMissile|[$ChangedDamage[&ThisTarget]]
     --=EmpoweredDamageFlag|1
     --]|
    --]|
   
   -->far_FIND_ACTIVE_GLOBAL_DAMAGE_MODS|[*S:character_id];GlobalDamage;0
   -->far_CheckDamageModifiers|[*[&ThisTarget]:character_id];[&damageType];damageMod;0;0;0
   --=ResultantDamage|[$ThisMissile.Raw] [&damageMod][&HexBlade][&Hex][&GlobalDamage]
   --=TotalDamage|[$TotalDamage] + [$ResultantDamage]   
   --?"X[&damageMode]" -eq "X1"|[
    --&ResultLabel[$TargetCount.Raw]|Bolt [$TargetCount.Raw]
    --&ResultText[$TargetCount.Raw]|Hits [*[&ThisTarget]:t-name] for [$ResultantDamage] [b][&damageType][/b] damage.
    --]|[
    --+Bolt [$TargetCount.Raw]: |Hits [*[&ThisTarget]:t-name] for [$ResultantDamage] [b][&damageType][/b] damage.
    --]|
   --=Damage[&ThisTarget]|[$Damage[&ThisTarget]] + [$ResultantDamage]
   --&DartTarget[$TargetCount.Raw]|[&ThisTarget]
   --=DartDamage[$TargetCount.Raw]|[$ResultantDamage]
   --?[*[&ThisTarget]:t-bar1_value] -lt 0|[
	 -->LibSN_ADD_STATUS_MARKER|[*[&ThisTarget]:t-id];dead
	 --]|
   --<|
  
  --:MissileSameDamage|
   --=OneMissileDamage|1d4+1
   --?"X[$EmpowerFeatFlag]" -eq "X1"|>far_EmpowerSelect;OneMissileDamage;Hit;SharedEmpowerChangedFlag;SharedEmpowerChangedDamage
   --?"X[$SharedEmpowerChangedFlag]" -eq "X1"|[
    --=OneMissileDamage|[$SharedEmpowerChangedDamage]
    --=EmpoweredDamageFlag|1
    --]|
   --+Damage per dart: |[$OneMissileDamage]
	 --+|[br]
   --<|
  
  --:ShieldMitigation|
   --=ResultantDamage|0
	 --=TotalDamage|[$TotalDamage] + [$ResultantDamage]
   --?"X[&damageMode]" -eq "X1"|[
    --&ResultLabel[$TargetCount.Raw]|Bolt [$TargetCount.Raw]
    --&ResultText[$TargetCount.Raw]|Hits a Shield surrounding [*[&ThisTarget]:t-name] for 0 damage.
    --]|[
    --+Bolt [$TargetCount.Raw]: |Hits a Shield surrounding [*[&ThisTarget]:t-name] for 0 damage.
    --]|
   --&DartTarget[$TargetCount.Raw]|[&ThisTarget]
   --=DartDamage[$TargetCount.Raw]|0
   --<|
  
  --:FinalizeDartResults|
   --=TotalDamage|0
   --%ut|foreach;Unique
    --=Damage[&ut]|0
    --%|
   --%i|1;[$MissileCount];1
    --&ThisDartTarget|[&DartTarget[&i]]
    -->IsTargetShielded|[&ThisDartTarget];ShieldHit
    --?[&ShieldHit] -eq 1|[
     --&ResultText[&i]|Hits a Shield surrounding [*[&ThisDartTarget]:t-name] for 0 damage.
     --]|[
     --=TotalDamage|[$TotalDamage] + [$DartDamage[&i].Raw]
     --=Damage[&ThisDartTarget]|[$Damage[&ThisDartTarget]] + [$DartDamage[&i].Raw]
     --]|
    --%|
   --<|
  
  --:BuildUnique|
   --~|array;define;Unique;[@Targets(0)]
   --%loop|foreach;Targets
    --&ThisTarget|[&loop]
    --?"X[&ThisTarget]" -eq "X"|BottomUniqueLoop
    --~testvar|array;indexof;Unique;[&ThisTarget]
    --?"[&testvar]" -eq "ArrayError" | [
     --~|array;add;Unique;[&ThisTarget]
	   --]|
    --:BottomUniqueLoop|
    --%|
   --<|
  
  --:ShieldPrompt|
   --&ShieldTargetTID|[&loop]
   --&control|[*O:[*[&ShieldTargetTID]:t-represents]:character:controlledby]
   --&playername|[*O:[&control]:player:displayname]
   --?"X[&playername]" -eq "X"|[
    --#whisper|gm
	  --]|[
    --#whisper|[&playername],gm
	  --]|
  
   -->IsTargetShielded|[&ShieldTargetTID];InitalShieldFlag
   --?[&InitalShieldFlag] -eq 1|[
    -->MarkTargetShielded|
    --^ShieldReturn|
    --]|
   -->GetAndCheckSlotInformation|[*[&ShieldTargetTID]:t-id];1;shieldSpellLevel
   --+[*[&ShieldTargetTID]:t-name]: |You are being targeted by Magic Missile and can cast Shield.
   --+Do you want to cast Shield? |[c][rbutton]Yes::CheckMod;[&ShieldTargetTID][/rbutton][rbutton]No::No;[&ShieldTargetTID][/rbutton][/c]
   --X|
  
  --:No|
   --&ShieldTargetTID|[&reentryval]
   --^ShieldReturn|
  
  --:CheckMod|
   --&ShieldTargetTID|[&reentryval]
   -->MarkTargetShielded|
   --&TokenName|[*[&ShieldTargetTID]:character_name] Shield
   --&ReactName|[*[&ShieldTargetTID]:character_name] [&ReactCharName]
   -->MMShieldModExists|[*[&ShieldTargetTID]:t-id];Exists
   --?[&Exists] -eq 1|>SetMod |>CreateMod
   --=TargetTokenSpellSlot|[&shieldSpellLevel]
   -->far_DeductSpellSlot|[*[&ShieldTargetTID]:t-id];[$TargetTokenSpellSlot]
   -->TargetSpellContinue|
  
  --:CreateMod| 
  --!a:[*[&ShieldTargetTID]:character_id]|global_ac_mod_flag:1
	--!or:[*[&ShieldTargetTID]:character_id]:acmod|
	  global_ac_name:[&ModName]|
	  global_ac_val:5|
	  global_ac_active_flag:1|
	  options-flag:0
	-->far_PlayEffects|[*[&ShieldTargetTID]:t-id];;;burn-holy
  -->SpawnToken|
  --<|
  
  --:SetMod|  
   -->Lib5E_SET_GLOBAL_MOD_STATUS|[*[&ShieldTargetTID]:character_id];ac;[&ModName];1
   -->far_PlayEffects|[*[&ShieldTargetTID]:t-id];;;burn-holy
   -->SpawnToken|
   --<|
  
  --:SpawnToken|
   -->GetCharID|[&CharName];ShieldID
   -->GetCharID|[&ReactCharName];ReactID
	--!ot:ReactTID|name:"[&ReactName]"|left:[*[&ShieldTargetTID]:t-left]|top:[*[&ShieldTargetTID]:t-top]|width:[=[*[&ShieldTargetTID]:t-width]*3]|height:[=[*[&ShieldTargetTID]:t-height]*3]|imgsrc:"[&Reactlink]"|bar1_value:1|represents:[&ReactID]|showname:0
	--z:graphic:[&ReactTID]|toback
	--@CARRY_TOKENS_CARRY_BELOW|[*[&ShieldTargetTID]:t-id] [&ReactTID]
	--!ot:ShieldTID|name:"[&TokenName]"|left:[*[&ShieldTargetTID]:t-left]|top:[*[&ShieldTargetTID]:t-top]|width:[=[*[&ShieldTargetTID]:t-width]*3]|height:[=[*[&ShieldTargetTID]:t-height]*3]|imgsrc:"[&URLlink]"|bar1_value:1|represents:[&ShieldID]|showname:0
	--z:graphic:[&ShieldTID]|toback
	--@CARRY_TOKENS_CARRY_BELOW|[*[&ShieldTargetTID]:t-id] [&ShieldTID]
   --<|
  
  --:GetAndCheckSlotInformation|tokenid;SpellLevel;SpellLevelReturnString
   --=Slotlevel|[%2%]
   -->far_FIND_CLASS_LEVEL|[%1%];Warlock;WarLevel
   --?[&WarLevel] -ge 1|[
    --?[&WarLevel] -ge 9 |=Slotlevel;5
    --?[&WarLevel] -eqi 7 -or [&WarLevel] -eqi 8|=Slotlevel;4
    --?[&WarLevel] -eqi 5 -or [&WarLevel] -eqi 6 |=Slotlevel;3
    --?[&WarLevel] -eqi 3 -or [&WarLevel] -eqi 4 |=Slotlevel;2
    --?[&WarLevel] -lt 2 |=Slotlevel;1
    --]|
   --=SlotsExpended|[*[%1%]:lvl[$Slotlevel]_slots_expended]
   --?[$SlotsExpended.Total] -le 0|[
    --^ShieldReturn|
    --]|
   --&[%3%]|[$Slotlevel] 
   --<|
  
  --:TargetSpellContinue|
   --+Press to Continue: |[c][rbutton]Continue::ContinueReturn;[&ShieldTargetTID][/rbutton][/c]
   --X|
  
  --:ContinueReturn|
   --&ShieldTargetTID|[&reentryval]
   -->MarkTargetShielded|
   --^ShieldReturn|
  
  --:MarkTargetShielded|
   --&ShieldedList|+;[&ShieldTargetTID];
   --!a:[*[&ShieldTargetTID]:character_id]|[&ShieldMarkAttr]:1
   --<|
  
  --:ClearMMShieldMarks|
   --%shieldCleanup|foreach;Targets
    --!a:[*[&shieldCleanup]:character_id]|[&ShieldMarkAttr]:0
    --%|
   --<|
  
  --:IsTargetShielded|tokenid;returnvar
   --&[%2%]|0
   --?"X[&ShieldedList]" -inc ";[%1%];"|&[%2%];1
   --?"X[*[%1%]:mm_shield_active]" -eq "X1"|&[%2%];1
   --Rfind|[*[%1%]:character_id];[&ModName];repeating_acmod;global_ac_name
   --?"X[*R:global_ac_name]" -ne "XNoRepeatingAttributeLoaded" -and "X[*R:global_ac_active_flag]" -eq "X1"|&[%2%];1
   --<|
  
  --:MMShieldModExists|tokenid;returnvar
   --&[%2%]|0
   --Rfind|[*[%1%]:character_id];[&ModName];repeating_acmod;global_ac_name
   --?"X[*R:global_ac_name]" -ne "XNoRepeatingAttributeLoaded"|&[%2%];1
   --<|

--:GetCharID|CharacterName;StringVariableForCharID
 --~|array;objects:character;SpiritCharArr;[%1%]
 --?[@SpiritCharArr(length)] -ne 1|>far_FatalError;Could not find character named [%1%];ERROR;Create a journal character named [%1%] for Shield graphics
  --&[%2%]|[@SpiritCharArr(0)]
  --<|
}}