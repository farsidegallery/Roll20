!script {{
  +++5Elib;snlib;Farsidelib+++

  --#sourceToken|@{selected|token_id}
  --&SavedSourceToken|@{selected|token_id}
  --&CasterToken|[*S:t-id]
  --#reentrant|Blade Barrier @{selected|character_id}
  --#whisper|self,gm

  --/|Script Name : Blade Barrier
  --/|Version     : 1.2.0
  --/|Requires SC : ScriptCards 3.0.25+, 5Elib/snlib/Farsidelib
  --/|Author      : Farsidegallery
  --/|
  --/|  Casts Blade Barrier as a wall or circle at a Spell Token placement point.
  --/|  Setup: Blade Barrier Wall and Blade Barrier Circle must each have Blade Barrier Token pasted as a token action ability on that character. The spawned barrier uses that action for DEX saves and damage.
  --/|
  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________

  --&SpellName|Blade Barrier
  --&MinimumSpellLevel|6
  --/|Use ScriptCards (1) or SpawnDefaultToken (2) to place the barrier on the VTT?
  --&SpawnScript|1

  --/| Placement template character and image (move token, then target it to place the barrier).
  --&SpellTargetToken|Spell Token
  --&PlaceURLlink|https://files.d20.io/images/469753332/ew1SU1DcQK4eborJlOqNQw/original.png
     
  --/| ____________________ End Global User Variables ___________________________________________________________________________________________

  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[
  --&cbrac|]
  --&oparen|(
  --&cparen|)

  -->far_LoadTokenMarkers|

  --#title|[&SpellName]

  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
  -->far_GetAvailableSpellLevels|[*S:character_id];[&MinimumSpellLevel];SpellCastLevel
  --?[@SpellCastLevel(length)] -eq 0|>far_FatalError;No Spell Slots Available;ERROR;No spell slots are available to cast [&SpellName]
  -->GetCharID|[&SpellTargetToken];AOETargetID

  --#leftsub|[*R:spellcastingtime]
  --#rightsub|[*R:spellrange]
  --?[*R:spellconcentration] -inc 1|&duration;[*R:spellduration] [b](Concentration)[/b]|&duration;[*R:spellduration]

  --+Choose Function: |[rbutton]New Cast::NewCast[/rbutton][rbutton]Dismiss::Remove[/rbutton]
  --X|

  --:NewCast|
   --+|[b][c]What Shape is the Barrier?[/c][/b]
   --+|[c][rbutton]Wall::ChooseType;Wall[/rbutton][rbutton]Circle::ChooseType;Circle[/rbutton][/c]
   --X|

  --:ChooseType|
   --&Shape|[&reentryval]
   --?"[&Shape]" -eq "Circle"|[
    --=size1|15
    --=size2|15
    --&URLlink|https://files.d20.io/images/466433790/srPN_FGthxfT1hnlhT0BPg/med.webm?1764788816
   --]|
   --?"[&Shape]" -eq "Wall"|[
    --=size1|3
    --=size2|22
    --&URLlink|https://files.d20.io/images/466433791/QujYB2H3cDLYFJmtW0ucDg/med.webm?1764788816
   --]|
   --&BarrierShape|Blade Barrier [&Shape]
   -->CAST_SPELL|
   --X|

  --/| ____________________ Procedures_______________________________________________________________________________________

  --:CAST_SPELL|
   --#sourceToken|[&CasterToken]
   --+|Move Spell Token to desired location and then target it by casting the spell.
   --!ot:NewTID|name:"[&SpellTargetToken]"|_pageid:[*S:t-_pageid]|left:[=[*S:t-left]+70]|top:[*S:t-top]|width:[*S:t-width]|height:[*S:t-height]|imgsrc:"[&PlaceURLlink]"|bar1_value:1|represents:"[&SpellTargetToken]"|showname:0
   --&PlacementTID|[&NewTID]
   --z:graphic:[&NewTID]|tofront
   -->SetAbility|
   --+Target: |[rbutton]Target the Spell Token.::SetTarget;[&TB]target|token_id}[/rbutton]
   --X|

  --:SetTarget|
   --#sourceToken|[&CasterToken]
   --?"X[&reentryval]" -eq "X"|>far_FatalError;Wrong Target;ERROR;Click Target the Spell Token, then select the placement token.
   --#targettoken|[&reentryval]
   --&TargetName|[*T:character_name]
   --?"[&reentryval]" -eq "[&PlacementTID]"|SpawnBarrier
   --?"[&TargetName]" -eq "[&SpellTargetToken]"|SpawnBarrier
   -->far_FatalError;Wrong Target;ERROR;Target the spell placement token.
   --<|

  --:SpawnBarrier|
   --#sourceToken|[&CasterToken]
   --&PlaceLeft|[*T:t-left]
   --&PlaceTop|[*T:t-top]
   --&PlaceCellW|[*T:t-width]
   --&PlaceCellH|[*T:t-height]
   --#targettoken|notoken
   --&TokenName|[*S:t-name] [&SpellName]
   --#emoteText|[*S:t-name] casts [&SpellName]!
   -->GetCharID|[&BarrierShape];ShapeID
   --!a:[&ShapeID]|!SaveDC:[*S:spell_save_dc]
   --!a:[&ShapeID]|!CasterCharID:[*S:character_id]
   --!a:[&ShapeID]|!CasterTokenID:[*S:t-id]
   --!a:[*S:character_id]|!ConcentrationSpell:[&TokenName]
   -->LibSN_ADD_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];10
   --&Player|[*O:[*S:t-represents]:character:controlledby]
   --&controllers|[*O:[&ShapeID]:character:controlledby]
   --?"[&controllers]" -ninc "-"|&controllers;None
   --?[&controllers] -eq None|&newcontrollers;[&Player] |&newcontrollers;[&controllers],[&Player]
   --!c:[&ShapeID]|controlledby:[&newcontrollers]
   --?[&SpawnScript] -eq 1|[
    --!ot:SpiritTID|name:"[&TokenName]"|left:[&PlaceLeft]|top:[&PlaceTop]|width:[=[&PlaceCellW]*[$size2]]|height:[=[&PlaceCellH]*[$size1]]|imgsrc:"[&URLlink]"|bar1_value:1|represents:[&ShapeID]|showname:false|tooltip:DC [*S:spell_save_dc]|show_tooltip:true
    --z:graphic:[&SpiritTID]|toback
   --]|
   --?[&SpawnScript] -eq 2|[
    --#targettoken|[&PlacementTID]
    --@forselected+|Spawn _name|[&BarrierShape] _qty|1 _offset|0,0 _size|[$size1],[$size2] _force|yes _tokenProps|name:[&TokenName],showname:false,showplayers_name:false,tooltip:DC [*S:spell_save_dc],show_tooltip:true _order|toBack _bar1|KeepLink _fx|nova-magic _expand|15,30 {^&select [&TB]target|token_id[&cbrace]}
    --#targettoken|notoken
   --]|
   --~|object;token;delete;[&PlacementTID]
   -->SetBarrierAbility|
   --?[*S:npc] -eq 1|[
    --?"X[&SpiritTID]" -ne "X"|[
     --!graphic:[&SpiritTID]|gm_only_tooltip:1
    --]|[
     --~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&TokenName]
     --?[@tokens(length)] -ge 1|[
      --!graphic:[@tokens(0)]|gm_only_tooltip:1
     --]|
    --]|
   --]|
   -->Output|
   --X|

  --:SetAbility|
   --~|array;objects:ability;AbilityArr;;[&AOETargetID]
   --?[@AbilityArr(length)] -ge 1|[
    --!ability:[@AbilityArr(0)]|istokenaction:False
   --]|
   --?[@AbilityArr(length)] -ge 2|[
    --!ability:[@AbilityArr(1)]|istokenaction:False
   --]|
   --?[@AbilityArr(length)] -ge 3|[
    --!ability:[@AbilityArr(2)]|istokenaction:False
   --]|
   --?[@AbilityArr(length)] -ge 4|[
    --!ability:[@AbilityArr(3)]|istokenaction:False
   --]|
   --<|

  --:SetBarrierAbility|
   --~|array;objects:ability;AbilityArr;;[&ShapeID]
   --?[@AbilityArr(length)] -ge 1|[
    --!ability:[@AbilityArr(0)]|istokenaction:True
   --]|
   --<|

  --:Output|
   --#whisper|
   --#sourceToken|[&CasterToken]
   -->far_PlayEffects|[*S:t-id];;burn-magic;;;
   --+|[*S:t-name] summons a [&SpellName] in the shape of a [&Shape]!
   --+|[br]
   --+Duration: |[&duration]
   --+Desc: |[*R:spelldescription]
   -->far_DeductSpellSlot|[*S:t-id];[&MinimumSpellLevel]
   --X|

  --:GetCharID|CharacterName;StringVariableForCharID
   --~|array;objects:character;SpiritCharArr;[%1%]
   --?[@SpiritCharArr(length)] -ne 1|>far_FatalError;Character Not Found;ERROR;Could not find character named [%1%]
   --&[%2%]|[@SpiritCharArr(0)]
   --<|

  --:Remove|
   --#whisper|
   --#sourceToken|[&SavedSourceToken]
   -->LibSN_REMOVE_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker]
   --&TokenName|[*S:ConcentrationSpell]
   --?"X[&TokenName]" -eq "X" -or "[&TokenName]" -eq "**"|&TokenName;[*S:t-name] [&SpellName]
   --~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&TokenName]
   --?[@tokens(length)] -ge 1|[
    --%DelLoop|foreach;tokens
     --~|object;token;delete;[*[&DelLoop]:t-id]
    --%|
   --]|
   --~count|array;pagetokens;tokens;[*S:t-id];tprop:name=[&SpellTargetToken]
   --?[@tokens(length)] -ge 1|[
    --~|object;token;delete;[@tokens(0)]
   --]|
   --!a:[*S:character_id]|!ConcentrationSpell:**
   --#emoteText|[*S:character_name] is no longer concentrating on [&SpellName]!
   --+|[*S:character_name]'s [&SpellName] vanishes.
   --X|
}}