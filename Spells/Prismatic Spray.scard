!scriptcards {{
  +++5Elib;snlib;Farsidelib+++

  --#sourceToken|@{selected|token_id}
  --#reentrant|Prismatic Spray @{selected|character_id}
  --#whisper|self,gm  
  
  --/|Script Name : Prismatic Spray
  --/|Version     : 2.0.0
  --/|Requires SC : TokenMod, SuperNotes (for template override only), ScriptCards Library 5Elib/snlib/Farsidelib
  --/|Author      : Farsidegallery
  --/|Base Code   : Base code taken from Matt M.'s Cone of Cold. That was in turn based on Kurt's Burning Hands script.
  --/|  
  --/|  Script prompts user direction of spell cone, determines targets affects, rolls saving throws, and applies damage or conditions as appropriate. 
  --/|  Results are output in a table format.
  --/|

  --/| ____________________ Begin Global User Variables -Update the variables below to your game settings. ___________________________________
  
  --&SpellName|Prismatic Spray
  --&MinimumSpellLevel|7
  
  --/|Per-grid-square VFX in the cone (TokenMod). Leave blank to skip square VFX.
  --&tokenVFX|burn-magic
  --/|Line VFX from caster center to the farthest cone square (TokenMod). Leave blank to skip.
  --&lineVFX|breath-magic
  
  --/|Set this to either "token-mod", "alterbars", or anything else to not apply damage
  --&damageApplyScript|token-mod
   
  --&attrib|dexterity
  
  --/|What resource name is used for Sorcerer Points?
  --&SorcererResource|Sorcery Points
  
  --/|Set this to a list of layers to a semicolon separated check for tokens on. By default, objects and gmlayer are checked.
  --/|possible values are objects, gmlayer, and map, so to check all three, use "objects;gmlayer;map"
  --&checkLayers|objects;gmlayer
  
  --/|Are you using the matching Bardic Inspiration Script from FarsideGallery? (Default is No using 0. Change to 1 if using the script.)
  --=Scriptcheck|1
  
  --/| ____________________ End Global User Variables ___________________________________________________________________________________________ 
 
  --/|Helper variable build up to allow us to include a target prompt in an rbutton
  --&TB|& --&TB|+# --&TB|+64 --&TB|+; --&TB|+{
  --&SPACE|X X --&SPACE|[&SPACE(1,1)]
  --&brace|{
  --&cbrace|}
  --&obrac|[ 
  --&cbrac|]
  --&oparen|(
  --&cparen|)
  
  --~shortattrib|string;left;3;[&attrib]
  --~Displayattrib|string;touppercase;[&shortattrib]
  
  -->far_LoadTokenMarkers|
  
  --#title|[&SpellName]
  --Rfind|[*S:character_id];[&SpellName];repeating_spell-[&MinimumSpellLevel];spellname
  --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|>far_FatalError;Spell Not Found;ERROR;Could not find a level [&MinimumSpellLevel] spell named [&SpellName]
  -->far_GetAvailableSpellLevels|[*S:character_id];[&MinimumSpellLevel];SpellCastLevel
  --?[@SpellCastLevel(length)] -eq 0|>far_FatalError;No Spell Slots Available;ERROR;No spell slots are available to cast [&SpellName]
  
  -->far_GetAndCheckSlotInformation|[*S:t-id];[&MinimumSpellLevel]
  
  --=DC|[*S:spell_save_dc]
  
  --#leftsub|Range: [*R:spellrange]
  --#rightsub|[&Displayattrib] Save DC: [$DC]
  --#emoteBackground|#eeffee
  --#emoteText|[*S:t-name] casts [&SpellName]!
  --&range|[*R:spellrange]
  --&desc|[*R:spelldescription]

  -->far_FIND_CLASS_LEVEL|[*S:character_id];Sorcerer;SLevel
  --?"X[&SLevel]" -eq "X0"|ChooseLevel
  -->far_FindFeat|[*S:character_id];"Metamagic: Empowered Spell";EmpowerFeatFlag
  -->far_FindFeat|[*S:character_id];"Wild Magic Surge";WildFeatFlag
  -->Lib5E_FIND_RESOURCE|[*S:character_id];[&SorcererResource];Pointsname;PointsAmmo
  --=EmpowerDice|[*S:charisma_mod]
  --=SorceryPoints|0
  --=ChangeCount|0
  
  --:ChooseLevel|
  --/|Get all of the tokens on the page so we can cache their positions
  --~|array;pagetokens;alltokens;[*S:t-id]
  --#activepage|[*S:t-_pageid]
  --=scaler|[*P:snapping_increment] * 70
  --?[$scaler] -eq 0|=scaler;70
  --=halfscaler|[$scaler] \ 2
  --=doublescaler|[$scaler] * 2
  --=triplescaler|[$scaler] * 3
  
  --/|Calculate base damage of each ray.
  --=RedBaseDam|10d6
  --=OrangeBaseDam|10d6
  --=YellowBaseDam|10d6
  --=GreenBaseDam|10d6
  --=BlueBaseDam|10d6
  
  --?"X[$EmpowerFeatFlag]" -eq "X1"|>EmpowerArray
  
  --/|Create an array to hold the tokens that are intersected by the line.
  --~|array;define;tokensHit;
  
  -->createTokenLookup|
  --/|Prompt for a direction for the cast, and define arrays that indicate the relative spaces that will be hit.
  --&emoUp|& --&emoUp|+# --&emoUp|+x2B06;
  --&emoUPRight|& --&emoUPRight|+# --&emoUPRight|+x2197;
  --&emoRight|& --&emoRight|+# --&emoRight|+x27A1;
  --&emoDownRight|& --&emoDownRight|+# --&emoDownRight|+x2198;
  --&emoDown|& --&emoDown|+# --&emoDown|+x2B07;
  --&emoUpLeft|& --&emoUpLeft|+# --&emoUpLeft|+x2196;
  --&emoLeft|& --&emoLeft|+# --&emoLeft|+x2B05;
  --&emoDownLeft|& --&emoDownLeft|+# --&emoDownLeft|+x2199;

  --+|[c][b]Cast In What Direction?[/b][/c]
  --#buttonwidth|25%
  --+|[c][rbutton][&emoUpLeft] (UP-LEFT)::AttackDirection;UL[/rbutton][rbutton][&emoUp] (Up)::AttackDirection;U[/rbutton][rbutton][&emoUPRight] (UP-RIGHT)::AttackDirection;UR[/rbutton][/c]
  --+|[c][rbutton][&emoLeft] (LEFT)::AttackDirection;L[/rbutton][rbutton][&emoRight] (RIGHT)::AttackDirection;R[/rbutton][/c]
  --+|[c][rbutton][&emoDownLeft] (DOWN-LEFT)::AttackDirection;DL[/rbutton][rbutton][&emoDown] (DOWN)::AttackDirection;D[/rbutton][rbutton][&emoDownRight] (DOWN-RIGHT)::AttackDirection;DR[/rbutton][/c]
  --X|
  
  --:AttackDirection|
  --&Direction|[&reentryval]
  --#activepage|[*S:t-_pageid]
  --~|array;define;U;0,-1;-1,-2;0,-2;1,-2;-1,-3;0,-3;1,-3;-2,-4;-1,-4;0,-4;1,-4;2,-4;-2,-5;-1,-5;0,-5;1,-5;2,-5;-3,-6;-2,-6;-1,-6;0,-6;1,-6;2,-6;3,-6;-3,-7;-2,-7;-1,-7;0,-7;1,-7;2,-7;3,-7;-4,-8;-3,-8;-2,-8;-1,-8;0,-8;1,-8;2,-8;3,-8;4,-8;-4,-9;-3,-9;-2,-9;-1,-9;0,-9;1,-9;2,-9;3,-9;4,-9;-5,-10;-4,-10;-3,-10;-2,-10;-1,-10;0,-10;1,-10;2,-10;3,-10;4,-10;5,-10;-5,-11;-4,-11;-3,-11;-2,-11;-1,-11;0,-11;1,-11;2,-11;3,-11;4,-11;5,-11;-6,-12;-5,-12;-4,-12;-3,-12;-2,-12;-1,-12;0,-12;1,-12;2,-12;3,-12;4,-12;5,-12;6,-12
  --~|array;define;D;0,1;-1,2;0,2;1,2;-1,3;0,3;1,3;-2,4;-1,4;0,4;1,4;2,4;-2,5;-1,5;0,5;1,5;2,5;-3,6;-2,6;-1,6;0,6;1,6;2,6;3,6;-3,7;-2,7;-1,7;0,7;1,7;2,7;3,7;-4,8;-3,8;-2,8;-1,8;0,8;1,8;2,8;3,8;4,8;-4,9;-3,9;-2,9;-1,9;0,9;1,9;2,9;3,9;4,9;-5,10;-4,10;-3,10;-2,10;-1,10;0,10;1,10;2,10;3,10;4,10;5,10;-5,11;-4,11;-3,11;-2,11;-1,11;0,11;1,11;2,11;3,11;4,11;5,11;-6,12;-5,12;-4,12;-3,12;-2,12;-1,12;0,12;1,12;2,12;3,12;4,12;5,12;6,12
  --~|array;define;R;1,0;2,-1;2,0;2,1;3,-1;3,0;3,1;4,-2;4,-1;4,0;4,1;4,2;5,-2;5,-1;5,0;5,1;5,2;6,-3;6,-2;6,-1;6,0;6,1;6,2;6,3;7,-3;7,-2;7,-1;7,0;7,1;7,2;7,3;8,-4;8,-3;8,-2;8,-1;8,0;8,1;8,2;8,3;8,4;9,-4;9,-3;9,-2;9,-1;9,0;9,1;9,2;9,3;9,4;10,-5;10,-4;10,-3;10,-2;10,-1;10,0;10,1;10,2;10,3;10,4;10,5;11,-5;11,-4;11,-3;11,-2;11,-1;11,0;11,1;11,2;11,3;11,4;11,5;12,-6;12,-5;12,-4;12,-3;12,-2;12,-1;12,0;12,1;12,2;12,3;12,4;12,5;12,6
  --~|array;define;L;-1,0;-2,-1;-2,0;-2,1;-3,-1;-3,0;-3,1;-4,-2;-4,-1;-4,0;-4,1;-4,2;-5,-2;-5,-1;-5,0;-5,1;-5,2;-6,-3;-6,-2;-6,-1;-6,0;-6,1;-6,2;-6,3;-7,-3;-7,-2;-7,-1;-7,0;-7,1;-7,2;-7,3;-8,-4;-8,-3;-8,-2;-8,-1;-8,0;-8,1;-8,2;-8,3;-8,4;-9,-4;-9,-3;-9,-2;-9,-1;-9,0;-9,1;-9,2;-9,3;-9,4;-10,-5;-10,-4;-10,-3;-10,-2;-10,-1;-10,0;-10,1;-10,2;-10,3;-10,4;-10,5;-11,-5;-11,-4;-11,-3;-11,-2;-11,-1;-11,0;-11,1;-11,2;-11,3;-11,4;-11,5;-12,-6;-12,-5;-12,-4;-12,-3;-12,-2;-12,-1;-12,0;-12,1;-12,2;-12,3;-12,4;-12,5;-12,6
  --~|array;define;UR;1,-1;1,-2;1,-3;2,-1;2,-2;2,-3;2,-4;2,-5;2,-6;3,-1;3,-2;3,-3;3,-4;3,-5;3,-6;3,-7;3,-8;3,-9;4,-2;4,-3;4,-4;4,-5;4,-6;4,-7;4,-8;4,-9;4,-10;4,-11;4,-12;5,-2;5,-3;5,-4;5,-5;5,-6;5,-7;5,-8;5,-9;5,-10;5,-11;5,-12;5,-13;6,-2;6,-3;6,-4;6,-5;6,-6;6,-7;6,-8;6,-9;6,-10;6,-11;6,-12;7,-3;7,-4;7,-5;7,-6;7,-7;7,-8;7,-9;7,-10;7,-11;8,-3;8,-4;8,-5;8,-6;8,-7;8,-8;8,-9;8,-10;9,-3;9,-4;9,-5;9,-6;9,-7;9,-8;9,-9;10,-4;10,-5;10,-6;10,-7;10,-8;11,-4;11,-5;11,-6;11,-7;12,-4;12,-5;12,-6;13,-5
  --~|array;define;DR;1,1;2,1;3,1;1,2;2,2;3,2;4,2;5,2;6,2;1,3;2,3;3,3;4,3;5,3;6,3;7,3;8,3;9,3;2,4;3,4;4,4;5,4;6,4;7,4;8,4;9,4;10,4;11,4;12,4;2,5;3,5;4,5;5,5;6,5;7,5;8,5;9,5;10,5;11,5;12,5;13,5;2,6;3,6;4,6;5,6;6,6;7,6;8,6;9,6;10,6;11,6;12,6;3,7;4,7;5,7;6,7;7,7;8,7;9,7;10,7;11,7;3,8;4,8;5,8;6,8;7,8;8,8;9,8;10,8;3,9;4,9;5,9;6,9;7,9;8,9;9,9;4,10;5,10;6,10;7,10;8,10;4,11;5,11;6,11;7,11;4,12;5,12;6,12;5,13
  --~|array;define;UL;-1,-1;-1,-2;-1,-3;-2,-1;-2,-2;-2,-3;-2,-4;-2,-5;-2,-6;-3,-1;-3,-2;-3,-3;-3,-4;-3,-5;-3,-6;-3,-7;-3,-8;-3,-9;-4,-2;-4,-3;-4,-4;-4,-5;-4,-6;-4,-7;-4,-8;-4,-9;-4,-10;-4,-11;-4,-12;-5,-2;-5,-3;-5,-4;-5,-5;-5,-6;-5,-7;-5,-8;-5,-9;-5,-10;-5,-11;-5,-12;-5,-13;-6,-2;-6,-3;-6,-4;-6,-5;-6,-6;-6,-7;-6,-8;-6,-9;-6,-10;-6,-11;-6,-12;-7,-3;-7,-4;-7,-5;-7,-6;-7,-7;-7,-8;-7,-9;-7,-10;-7,-11;-8,-3;-8,-4;-8,-5;-8,-6;-8,-7;-8,-8;-8,-9;-8,-10;-9,-3;-9,-4;-9,-5;-9,-6;-9,-7;-9,-8;-9,-9;-10,-4;-10,-5;-10,-6;-10,-7;-10,-8;-11,-4;-11,-5;-11,-6;-11,-7;-12,-4;-12,-5;-12,-6;-13,-5
  --~|array;define;DL;-1,1;-1,2;-1,3;-2,1;-2,2;-2,3;-2,4;-2,5;-2,6;-3,1;-3,2;-3,3;-3,4;-3,5;-3,6;-3,7;-3,8;-3,9;-4,2;-4,3;-4,4;-4,5;-4,6;-4,7;-4,8;-4,9;-4,10;-4,11;-4,12;-5,2;-5,3;-5,4;-5,5;-5,6;-5,7;-5,8;-5,9;-5,10;-5,11;-5,12;-5,13;-6,2;-6,3;-6,4;-6,5;-6,6;-6,7;-6,8;-6,9;-6,10;-6,11;-6,12;-7,3;-7,4;-7,5;-7,6;-7,7;-7,8;-7,9;-7,10;-7,11;-8,3;-8,4;-8,5;-8,6;-8,7;-8,8;-8,9;-8,10;-9,3;-9,4;-9,5;-9,6;-9,7;-9,8;-9,9;-10,4;-10,5;-10,6;-10,7;-10,8;-11,4;-11,5;-11,6;-11,7;-12,4;-12,5;-12,6;-13,5
  --/|Call the "checkForTokenHits" subroutine. The passed parameter will be the per-space VFX. Leave blank for none.
  -->checkForTokenHits|[&tokenVFX]
  --/|The first item in the array will be a blank dummy item, so remove it.
  --~|array;removeat;tokensHit;0
  
  --+|[c]Eight multicolored rays of light flash from your hand. Each ray is a different color and has a different power and purpose.[/c]
  --+|[t][t border=3 width=100%][tr][td][c][b]Base Damage:[/b][/c][/td][/tr]
  --+|[t border=3 width=100%][tr][td style="width:105px"] [b]Yellow[/b] (Lightning): [$YellowBaseDam] [/td][/tr]
  --+|[t border=3 width=100%][tr][td style="width:105px"] [b]Red[/b] (Fire): [$RedBaseDam][/td][td style="width:105px"] [b]Green[/b] (Poison): [$GreenBaseDam][/td][/tr]
  --+|[t border=3 width=100%][tr][td style="width:105px"] [b]Orange[/b] (Acid): [$OrangeBaseDam][/td][td style="width:105px"] [b]Blue[/b] (Cold): [$BlueBaseDam] [/td][/tr]
  --+|[t border=3 width=100%][tr][td style="width:105px"] [b]Indigo[/b] (Restrained)[/td][td style="width:105px"] [b]Violet[/b] (Blinded) [/td][/tr]
  --+|[br]
  --+|[t border=3 width=100%][tr][td style="width:100px"][c]Target[/c][/td][td style="width:50px"][c]Color[/c][/td][td style="width:50px"][c]P/F?[/c][/td][td style="width:50px"][c]DAM[/c][/td][/tr]
  
  --/|Loop through the tokensHit tokens and roll saves for each one and apply damage
  --~tokenid|array;getfirst;tokensHit
  --?[&tokenid] -eq ArrayError|endOutput
  --:loopDisplay|
   --=RayColor|1d8
   --c[$RayColor.Raw]|1:>Physical;[&tokenid];Red;fire;[$RedBaseDam]|2:>Physical;[&tokenid];Orange;acid;[$OrangeBaseDam]|3:>Physical;[&tokenid];Yellow;lightning;[$YellowBaseDam]|4:>Physical;[&tokenid];Green;poison;[$GreenBaseDam]|5:>Physical;[&tokenid];Blue;cold;[$BlueBaseDam]|6:>Condition;[&tokenid];Indigo;Restrained|7:>Condition;[&tokenid];Violet;Blinded|8:>Special;[&tokenid]
   --~tokenid|array;getnext;tokensHit
   --?[&tokenid] -eq ArrayError|endOutput
   --^loopDisplay|

  --:endOutput| 
   --#whisper|
   --+|[br]
   --?"X[$WildFeatFlag]" -eq "X1" -and [&MinimumSpellLevel] -ge 1|>far_WildTable
   
   --+|[br]
   --+Desc: |[&desc]
   --+|[br]
   -->far_DeductSpellSlot|[*S:t-id];[&MinimumSpellLevel]
   
   --?"X[$EmpoweredDamageFlag]" -eq "X1" -or "X[$TwinFlag]" -eq "X1"|[
    --=FinalPointsAmmo|[$PointsAmmo]-[$SorceryPoints]
    --!a:[*S:character_id]|[&PointsAmmo]:[$FinalPointsAmmo]
    --+|[br]
	--+[&SorcererResource]: |Used: [$SorceryPoints] / Remaining: [$FinalPointsAmmo]
    --]|
   --X|

  --/| ____________________ Procedures_______________________________________________________________________________________
  
  --:Physical|targetID;color;damageType;baseDam
   --&tid|[%1%]
   --&GlobalSave|
   --&GlobalSkill|
   --&Baneroll|
   --&BardRoll|
   --&Hex|
   --&HexBlade|
   --&GlobalDamage|
   --&saveDice|1d20
   
   --?[*[&tid]:npc] -eq 1|[
    --?[*[&tid]:npc_dexterity_save_flag] -gt 0|&SaveField;npc_dexterity_save|&SaveField;dexterity_mod
    --=InitSave|[&saveDice]
    --=TargetSave|[$InitSave] + [*[&tid]:[&SaveField]] [&obrac][&Displayattrib][&cbrac]
   --]|[
    -->far_Check_GLOBAL_MOD_EXISTS|[*[&tid]:character_id]; save; [%3%]; damageSave
    -->far_Check_GLOBAL_ATTRIB_SAVE_EXISTS|[*[&tid]:character_id]; [&attrib]; attribSaveRoll
    --?[&damageSave] -eq 1 -and "[&saveDice]" -eqi "1d20"|&saveDice;2d20kh1
    --?[&attribSaveRoll] -eq 1 -and "[&saveDice]" -eqi "1d20"|&saveDice;2d20kh1
    --?[&damageSave] -eq 1 -and "[&saveDice]" -eqi "2d20kl1"|&saveDice;1d20
    --?[&attribSaveRoll] -eq 1 -and "[&saveDice]" -eqi "2d20kl1"|&saveDice;1d20
    -->LibSN_CHECK_STATUS_MARKER|[&tid];[&InspirationMarker];InspiredFlag;InspiredCount
    -->LibSN_CHECK_STATUS_MARKER|[&tid];[&BardicMarker];BardicFlag;BardicCount
    -->LibSN_CHECK_STATUS_MARKER|[&tid];[&BaneMarker];BaneMarkerFlag;BaneMarkerCount
    -->far_FIND_ACTIVE_GLOBAL_SAVE_MODS|[*[&tid]:character_id];GlobalSave
    -->far_FIND_ACTIVE_GLOBAL_SKILL_MODS|[*[&tid]:character_id];GlobalSkill
    --?[&InspiredFlag] -ne 0 |>far_Inspiration;[&tid];[&InspirationMarker];[&saveDice];saveDice
    --=InitSave|[&saveDice]
    --=midSave|[$InitSave] + [*[&tid]:[&attrib]_save_bonus] [&Displayattrib]
    --?[&BardicFlag] -eq 1|>far_Bardic;[&tid];[&BardicMarker];[$Scriptcheck];[$InitSave.Base];[$midSave];BardRoll
    --?[&BaneMarkerFlag] -eq 1|&Baneroll;+ - 1d4 [Bane] |&Baneroll;
    --=TargetSave|[$InitSave] + [*[&tid]:[&attrib]_save_bonus] [&obrac][&Displayattrib][&cbrac] [&GlobalSave] [&GlobalSkill] [&Baneroll] [&BardRoll]
   --]|
   
   -->far_CheckDamageModifiers|[*[&tid]:character_id];[%3%];damageMod;0;0;0
   --?"[&damageMod]" -inc "Immune"|[
    --&DexSave|I
    --=FinalDamage|0
    --+|[t border=3 width=100%][tr][td style="width:100px"][c][*[&tid]:t-name][/c][/td][td style="width:50px"][c][%2%][/c][/td][td style="width:50px"][c][&DexSave][/c][/td][td style="width:50px"][c]Immune[/c][/td][/tr]
    --<|
   --]|
   -->LibSN_CHECK_STATUS_MARKER|[&tid];[&HexMarker];HexMarkerFlag;HexMarkerCount
   -->LibSN_CHECK_STATUS_MARKER|[&tid];[&HexBladeMarker];HexBladeMarkerFlag;HexBladeMarkerCount
   --&GlobalDamage|
   -->far_FIND_ACTIVE_GLOBAL_DAMAGE_MODS|[*S:character_id];GlobalDamage;0;[*[&tid]:character_id]
   --?"X[&HexMarkerFlag]" -eq "X1" -and "X[*S:ConcentrationSpellTargetToken]" -eqi "X[*[&tid]:t-id]"|&Hex; + 1d6 [Hex] |&Hex;
   --?"X[&HexBladeMarkerFlag]" -eq "X1" -and "X[*[&tid]:CurseCaster]" -eq "X[*S:t-id]"|&HexBlade; + [*S:pb] [Hexblade Curse] |&HexBlade;
   
   --?[$TargetSave] -ge [$DC]|[
    --&DexSave|P
    --=FinalDamage|[%4%]\2 [&HexBlade] [&Hex][&GlobalDamage][&damageMod]
   --]|[
    --&DexSave|F
    --=FinalDamage|[%4%] [&HexBlade] [&Hex][&GlobalDamage][&damageMod]
   --]|  
   --+|[t border=3 width=100%][tr][td style="width:100px"][c][*[&tid]:t-name][/c][/td][td style="width:50px"][c][%2%][/c][/td][td style="width:50px"][c][&DexSave][/c][/td][td style="width:50px"][c][$FinalDamage][/c][/td][/tr]
   -->far_DamageTokenmod|[&tid];[&hpBar];[&tempHPbar];-[$FinalDamage];0;0;1
   --=FinalHP|[*[&tid]:t-bar[&hpBar]_value]+[*[&tid]:t-bar[&tempHPbar]_value]-[$FinalDamage]
   --?[$FinalHP] -le 0|>Died;[&tid]
   --<|
  
  --:Condition|targetID;color;cname
   --&tid|[%1%]
   --&colorname|[%2%]
   --&GlobalSave|
   --&GlobalSkill|
   --&Baneroll|
   --&BardRoll|
   --&saveDice|1d20
   
   --?[*[&tid]:npc] -eq 1|[
    --?[*[&tid]:npc_dexterity_save_flag] -gt 0|&SaveField;npc_dexterity_save|&SaveField;dexterity_mod
    --=InitSave|[&saveDice]
    --=TargetSave|[$InitSave] + [*[&tid]:[&SaveField]] [&obrac][&Displayattrib][&cbrac]
   --]|[
    -->far_Check_GLOBAL_ATTRIB_SAVE_EXISTS|[*[&tid]:character_id]; [&attrib]; attribSaveRoll
    --?[&attribSaveRoll] -eq 1 -and "[&saveDice]" -eqi "1d20"|&saveDice;2d20kh1
    --?[&attribSaveRoll] -eq 1 -and "[&saveDice]" -eqi "2d20kl1"|&saveDice;1d20
    -->LibSN_CHECK_STATUS_MARKER|[&tid];[&InspirationMarker];InspiredFlag;InspiredCount
    -->LibSN_CHECK_STATUS_MARKER|[&tid];[&BardicMarker];BardicFlag;BardicCount
    -->LibSN_CHECK_STATUS_MARKER|[&tid];[&BaneMarker];BaneMarkerFlag;BaneMarkerCount
    -->far_FIND_ACTIVE_GLOBAL_SAVE_MODS|[*[&tid]:character_id];GlobalSave
    -->far_FIND_ACTIVE_GLOBAL_SKILL_MODS|[*[&tid]:character_id];GlobalSkill
    --?[&InspiredFlag] -ne 0 |>far_Inspiration;[&tid];[&InspirationMarker];[&saveDice];saveDice
    --=InitSave|[&saveDice]
    --=midSave|[$InitSave] + [*[&tid]:[&attrib]_save_bonus] [&Displayattrib]
    --?[&BardicFlag] -eq 1|>far_Bardic;[&tid];[&BardicMarker];[$Scriptcheck];[$InitSave.Base];[$midSave];BardRoll
    --?[&BaneMarkerFlag] -eq 1|&Baneroll;+ - 1d4 [Bane] |&Baneroll;
    --=TargetSave|[$InitSave] + [*[&tid]:[&attrib]_save_bonus] [&obrac][&Displayattrib][&cbrac] [&GlobalSave] [&GlobalSkill] [&Baneroll] [&BardRoll]
   --]|
   
   --?[$TargetSave] -ge [$DC] | [
    --&DexSave|P
	--&Condition|
   --]|[
	--&DexSave|F
	--&Condition|[%3%]
	--?[&Condition] -eqi "Blinded" |&ConMarker;[&BlindedMarker]|&ConMarker;[&RestrainedMarker]
	--?"[*[&tid]:npc_immunities]" -inc "[&Condition]" -or "[*[&tid]:npc_condition_immunities]" -inc "[&Condition]"|[
	 --&Condition|[&Condition] (Immune)
	 --]|[
	 -->LibSN_ADD_STATUS_MARKER|[&tid];[&ConMarker];9
	 --]|
   --]|
   --+|[t border=3 width=100%][tr][td style="width:100px"][c][*[&tid]:t-name][/c][/td][td style="width:50px"][c][&colorname][/c][/td][td style="width:50px"][c][&DexSave][/c][/td][td style="width:50px"][c][&Condition][/c][/td][/tr]   
   --<|
  
  --:Special|targetID
   --+|[t border=3 width=100%][tr][td][c][*[%1%]:t-name] Rolled an 8![/c] [/td][/tr]
   -->Special1|
   -->Special2|
   --<|
   
  --:Special1| 
   --=SpecialDie1| 1d8r>8
   --c[$SpecialDie1.Raw]|1:>Physical;[&tokenid];Red;fire;[$RedBaseDam]|2:>Physical;[&tokenid];Orange;acid;[$OrangeBaseDam]|3:>Physical;[&tokenid];Yellow;lightning;[$YellowBaseDam]|4:>Physical;[&tokenid];Green;poison;[$GreenBaseDam]|5:>Physical;[&tokenid];Blue;cold;[$BlueBaseDam]|6:>Condition;[&tokenid];Indigo;Restrained|7:>Condition;[&tokenid];Violet;Blinded;
   --<|
   
  --:Special2|
   --=SpecialDie2| 1d8r>8 
   --c[$SpecialDie2.Raw]|1:>Physical;[&tokenid];Red;fire;[$RedBaseDam]|2:>Physical;[&tokenid];Orange;acid;[$OrangeBaseDam]|3:>Physical;[&tokenid];Yellow;lightning;[$YellowBaseDam]|4:>Physical;[&tokenid];Green;poison;[$GreenBaseDam]|5:>Physical;[&tokenid];Blue;cold;[$BlueBaseDam]|6:>Condition;[&tokenid];Indigo;Restrained|7:>Condition;[&tokenid];Violet;Blinded;
   --<|  
  
  --:checkForTokenHits|parameter is vfx descriptor
   --#activepage|[*S:t-_pageid]
   --=baseX|[*S:t-left] - 1 \ [$scaler]
   --=baseY|[*S:t-top] - 1 \ [$scaler]
   --~offset|array;getfirst;[&Direction]
  --:checkTokenLoop|
   --?"[&offset]" -eq "ArrayError"|endCheckForTokenHits
   --~split|string;split;,;[&offset]
   --=thisX|[$baseX] + [&split1]
   --=thisY|[$baseY] + [&split2]
   --=farConeX|[$thisX]
   --=farConeY|[$thisY]
   --/|IF we passed a visual effect specifier in %1%, create a point VFX in the square
   --?"X[%1%]X" -ne "XX"|[
    --=VX|[$thisX] * [$scaler] + [$halfscaler]
    --=VY|[$thisY] * [$scaler] + [$halfscaler]
    --vpoint|[$VX] [$VY] [%1%]
   --]|
   -->checkTokens|[$thisX];[$thisY]
   --~offset|array;getnext;[&Direction]
   --^checkTokenLoop|
  --:endCheckForTokenHits|
   --?"X[&lineVFX]X" -ne "XX"|[
    --=LX|[$farConeX] * [$scaler] + [$halfscaler]
    --=LY|[$farConeY] * [$scaler] + [$halfscaler]
    --vline|[*S:t-left] [*S:t-top] [$LX] [$LY] [&lineVFX]
   --]|
   --<|
    
  --/|Reads the variables created by createTokenLookup to find any tokens that occupy a given space.
  --:checkTokens|x;y
   --?"X[&tok[%1%]-[%2%]]X" -ne "XX"|[
   --~split|string;split;!;[&tok[%1%]-[%2%]]
   --%P|1;[$splitCount.Total];1
   --=var|split[&P]
   --?"X[&[$var.RollText]]X" -eq "XX"|%
   --~exists|array;indexof;tokensHit;[&[$var.RollText]]
   --?[&exists] -ne ArrayError|skipAdd
   --?[&[$var.RollText]] -eq ArrayError|skipAdd
   --~|array;add;tokensHit;[&[$var.RollText]]
  --:skipAdd|
   --%|
   --<|
  
  --/|Creates a series of string variables with names like 'tok12-15' which represent the various squares that are
  --/|occupied by tokens on the page. Handle 1x1, 2x2, and 3x3 tokens by simply adding extra squares in the appropriate
  --/|pattern around the center point location. The result is that if there are two tokens at 12,15, the tok12-15 string
  --/|will contain something like "-asln34njfn2nafd!-sdnfklaserfs" (IDs separated by exclamation points) that we can use to
  --/|quickly evaluate hits by essentially asking "what is in square 12x15" by just reading the variable.
  --:createTokenLookup|
   --~tokenid|array;getfirst;alltokens
  --:tokenSetupLoop|
    --?[&tokenid] -eq ArrayError|endSetupLoop
    --?[&checkLayers] -ninc [*[&tokenid]:t-layer]|skipThisToken
    --?[*[&tokenid]:t-bar[&hpBar]_value] -le 0|skipThisToken
    --=tLeft|[*[&tokenid]:t-left] - 1 \ [$scaler]
   --=tTop|[*[&tokenid]:t-top] - 1 \ [$scaler]
   --=tWidth|[*[&tokenid]:t-width]
   --?[$tWidth] -eq [$scaler]|[ 
    --&tok[$tLeft]-[$tTop]|+[&tokenid]!
   --]|
   --?[$tWidth] -eq [$doublescaler]|[ 
    --=NX|[$tLeft] + 1
    --=NY|[$tTop] + 1
    --&tok[$tLeft]-[$tTop]|+[&tokenid]!
    --&tok[$tLeft]-[$NY]|+[&tokenid]!
    --&tok[$NX]-[$tTop]|+[&tokenid]!
    --&tok[$NX]-[$NY]|+[&tokenid]!
   --]|
   --?[$tWidth] -eq [$triplescaler]|[  
    --=PX|[$tLeft] - 1
    --=PY|[$tTop] - 1
    --=NX|[$tLeft] + 1
    --=NY|[$tTop] + 1
      --&tok[$tLeft]-[$tTop]|+[&tokenid]!
      --&tok[$PX]-[$PY]|+[&tokenid]!
    --&tok[$tLeft]-[$PY]|+[&tokenid]!
    --&tok[$NX]-[$PY]|+[&tokenid]!
      --&tok[$PX]-[$tTop]|+[&tokenid]!
    --&tok[$NX]-[$tTop]|+[&tokenid]!
      --&tok[$PX]-[$NY]|+[&tokenid]!
      --&tok[$tLeft]-[$NY]|+[&tokenid]!
      --&tok[$NX]-[$NY]|+[&tokenid]!
   --]|
  --:skipThisToken|
   --~tokenid|array;getnext;alltokens
   --^tokenSetupLoop|
  --:endSetupLoop|
   --<|
  
  --:Died|tokenid
   --#whisper|
   --~|turnorder;removetoken;[%1%]
   -->LibSN_CHECK_STATUS_MARKER|[%1%];[&HexMarker];HexMarkerFlag;HexMarkerCount
   --?"X[&HexMarkerFlag]" -eq "X1" -and "X[*S:ConcentrationSpellTargetToken]" -eqi "X[*[%1%]:t-id]"|[
    -->LibSN_REMOVE_STATUS_MARKER|[%1%];[&HexMarker];0
    -->LibSN_REMOVE_STATUS_MARKER|[*S:t-id];[&ConcentrationMarker];0
   --]|
   -->LibSN_CHECK_STATUS_MARKER|[%1%];[&HexBladeMarker];HexBladeMarkerFlag;HexBladeMarkerCount
   --?"X[&HexBladeMarkerFlag]" -eq "X1" -and "X[*[%1%]:CurseCaster]" -eq "X[*S:t-id]"|[
    -->LibSN_REMOVE_STATUS_MARKER|[%1%];[&HexBladeMarker];0
   --]|
   -->LibSN_ADD_STATUS_MARKER|[%1%];[&DeathMarker]
   --<|
  
